API_URL=http://localhost:8080/api/v1
USE_MOCK=true
VIETNAM_PROVINCES_API_URL="https://provinces.open-api.vn/api/v2"

# Server-only. true keeps the design module (Module 12) on its mock while every other call reaches
# the real BE; USE_MOCK=true already mocks the design module too. Default false: the design module
# calls the BE's design API (/api/v1/designs, /design-projects, ...). API_URL above must end in /api/v1.
DESIGN_USE_MOCK=false
