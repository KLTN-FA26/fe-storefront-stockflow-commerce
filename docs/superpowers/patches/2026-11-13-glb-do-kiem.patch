+// @vitest-environment node
+import { readFileSync } from "node:fs";
+import path from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+import { buildGlbScene, disposeGlbScene } from "../model3d";
+import { loadGlb } from "../model3d/load";
+import { measureModel } from "../model3d/measure";
+import { templateDifferences } from "../model3d/compare-template";
+import { templateFromModel } from "../model3d/template-from-model";
+import { createSurfaces } from "../surfaces";
+import { customizationTemplateSchema } from "../template/schema";
+
+const SAMPLE = path.resolve(process.cwd(), "public/models/sample-cup-12oz.glb");
+
+/** What the model-check page does with a file, with the real functions and the real sample. */
+describe("the sample cup through the model-check chain", () => {
+  it("measures clean, builds its own template, and that template passes the viewer's comparison", async () => {
+    const file = readFileSync(SAMPLE);
+    const bytes = file.buffer.slice(file.byteOffset, file.byteOffset + file.byteLength);
+    const root = await loadGlb(bytes as ArrayBuffer);
+    const measured = measureModel(root, { byteLength: file.byteLength });
+    expect(measured.issues).toEqual([]);
+    expect(measured.model).toMatchObject({
+      topDiameterMm: 90,
+      bottomDiameterMm: 60,
+      heightMm: 110,
+      bandTopOffsetMm: 6,
+      bandBottomOffsetMm: 8,
+      seamMm: 8,
+    });
+
+    const template = templateFromModel(measured.model!, measured.printMeshes);
+    expect(customizationTemplateSchema.safeParse(template).success).toBe(true);
+    const surfaces = createSurfaces(template);
+    for (const part of measured.printMeshes) {
+      const surface = surfaces.byCode[part.printAreaCode]!;
+      expect(templateDifferences({ code: part.printAreaCode, surface, shape: part.shape }, measured.model!)).toEqual([]);
+    }
+
+    const scene = buildGlbScene(
+      root,
+      {
+        url: "sample-cup-12oz.glb",
+        surfaces: measured.printMeshes.map(({ printAreaCode, meshName }) => ({ printAreaCode, meshName })),
+      },
+      template.model as Parameters<typeof buildGlbScene>[2],
+      surfaces,
+    );
+    expect(scene.printMeshes.map((m) => m.code)).toEqual(["BODY"]);
+    disposeGlbScene(scene);
+  });
+});
