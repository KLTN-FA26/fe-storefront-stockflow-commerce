+"use client";
+
+import { Check, Copy } from "lucide-react";
+import { useState } from "react";
+
+import { Button } from "@/components/ui/button";
+
+import { configSnippet } from "./config-snippet";
+import { PASTE_STEPS } from "./model-check-messages";
+import type { MeasuredFile } from "./model-check-types";
+import type { Mould } from "./model-mould";
+
+type CopyState = "idle" | "copied" | "failed";
+
+/** The snippet to paste into the mock's print configuration, with a copy button. */
+export function ModelCheckJson({
+  file,
+  mould,
+}: {
+  file: MeasuredFile;
+  mould: Extract<Mould, { ok: true }>;
+}) {
+  const [copy, setCopy] = useState<CopyState>("idle");
+  const json = configSnippet(file, mould);
+
+  const onCopy = async () => {
+    try {
+      await navigator.clipboard.writeText(json);
+      setCopy("copied");
+    } catch {
+      // The clipboard can be blocked (an insecure address, permissions): the text is on screen.
+      setCopy("failed");
+    }
+  };
+
+  return (
+    <section aria-labelledby="model-check-json" className="space-y-3">
+      <h2 id="model-check-json" className="font-display text-ink-primary text-lg font-semibold">
+        Dòng để dán vào dữ liệu mẫu
+      </h2>
+      <ol
+        aria-label="Các bước dán vào dữ liệu mẫu"
+        className="text-ink-secondary list-decimal space-y-1 pl-5 text-sm"
+      >
+        {PASTE_STEPS.map((step) => (
+          <li key={step}>{step}</li>
+        ))}
+      </ol>
+      <pre
+        tabIndex={0}
+        aria-label="Đoạn cấu hình để dán"
+        className="bg-bg-subtle border-border-default text-ink-primary max-h-96 overflow-auto rounded-[var(--r-md)] border p-3 font-mono text-xs"
+      >
+        {json}
+      </pre>
+      <div className="flex items-center gap-3">
+        <Button
+          type="button"
+          className="min-h-11 rounded-[var(--r-md)] px-4"
+          onClick={() => void onCopy()}
+        >
+          {copy === "copied" ? <Check aria-hidden /> : <Copy aria-hidden />}
+          Sao chép
+        </Button>
+        <p role="status" className="text-ink-secondary text-sm">
+          {copy === "copied" && "Đã sao chép."}
+          {copy === "failed" && "Không sao chép được. Hãy chọn đoạn trên và sao chép bằng tay."}
+        </p>
+      </div>
+    </section>
+  );
+}
