+import type { Model3dErrorCode } from "../../engine";
+
+/** Millimetres with one decimal, as the page shows every size. */
+export const formatMm = (value: number) => `${value.toFixed(1)} mm`;
+
+/** The file convention, short enough to read before exporting from Blender (spec 2026-11-13 §7). */
+export const FILE_CHECKLIST: readonly string[] = [
+  "Kích thước thật: 1 đơn vị trong Blender bằng 1 mét (ly cao 110 mm thì ghi 0,11).",
+  "Khi xuất, trục Y hướng lên, đáy ở Y = 0, mặt trước nhìn về +Z.",
+  "Túi đặt chính giữa gốc toạ độ; ly có tâm đáy ở gốc toạ độ.",
+  "Phần in là object riêng, đặt tên đúng: print:BODY (ly) hoặc print:FRONT, print:BACK, print:LEFT, print:RIGHT (túi), không có đuôi .001.",
+  "Không để bản sao thân ly nằm dưới phần in: nó sẽ lộ ra qua hình in.",
+  "Khi xuất: tích Apply Modifiers; các mặt quay ra ngoài (Recalculate Outside).",
+  "Không nén Draco, không animation, nặng tối đa 10 MB.",
+];
+
+/** What the viewer's failure code means for the owner of the file, plainly. */
+export const VIEWER_FAILURE: Readonly<Record<Model3dErrorCode, string>> = {
+  LOAD_FAILED: "Không đọc được file khi dựng cảnh 3D. Hãy xuất lại file .glb từ Blender.",
+  ABORTED: "Việc dựng cảnh 3D đã bị dừng.",
+  MESH_MISSING:
+    "Không tìm thấy trong file phần in khớp với khuôn. Kiểm tra tên các object print:… trong Blender.",
+  INVALID_MODEL: "File không qua phần kiểm hình, nên chưa dựng được cảnh 3D. Xem danh sách lỗi.",
+  MODEL_MISMATCH:
+    "Số đo của phần in trong file lệch quá 1 mm so với khuôn tính ra, nên không dán lưới lên model.",
+};
+
+/** A file the page could not read as a `.glb` at all. */
+export const UNREADABLE_FILE =
+  "Không đọc được file này như một file .glb. Hãy xuất từ Blender bằng File > Export > glTF 2.0, chọn định dạng glTF Binary (.glb).";
+
+/** The plain name of each print part, for the tables. */
+export const PART_NAME = {
+  BODY: "Thân ly",
+  FRONT: "Mặt trước",
+  BACK: "Mặt sau",
+  LEFT: "Hông trái",
+  RIGHT: "Hông phải",
+} as const;
+
+/** What to do in Blender when a print part sits off the place the sizes read from the file ask for. */
+export const MISMATCH_HINT = {
+  cup: "Ly phải đứng thẳng quanh trục Y, tâm đáy đặt ở gốc toạ độ, đáy ở Y = 0.",
+  bag: "Túi phải đặt chính giữa gốc toạ độ: mặt trước ở +½ độ sâu hông theo trục Z, mặt sau ở −½, hai hông ở ±½ chiều rộng theo trục X, đáy ở Y = 0. Mỗi mặt cũng phải nằm giữa theo chiều ngang, không lệch sang một bên.",
+} as const;
+
+export const mismatchMessage = (kind: "cup" | "bag", difference: string) =>
+  `Một số đo của phần in lệch quá 1 mm so với khuôn tính từ chính file (${difference}). ${MISMATCH_HINT[kind]}`;
+
+/** How to read the axes in the messages, in Blender's terms. */
+export const AXES_NOTE =
+  "Cách đọc: các thông báo dùng trục của file .glb (Y hướng lên, mặt trước về +Z). Trong Blender, trục Z hướng lên và mặt trước nhìn về −Y; khi xuất ra .glb, Blender đổi sang Y lên và mặt trước +Z.";
+
+export const LEGEND = {
+  lines: "Đường mỏng cách nhau 10 mm, đường đậm cách nhau 50 mm; mỗi ô 50 mm có một số.",
+  cup: "Trên ly hình nón, chiều dọc thân luôn đúng 50 mm mỗi ô, còn chiều ngang chỉ đúng 50 mm ở giữa thân và giãn rộng dần về phía miệng ly.",
+  margins:
+    "Tràn lề: phần hình kéo ra ngoài đường cắt để không bị viền trắng. Lề an toàn: vùng cách mép vào trong, chữ và logo quan trọng nên nằm trong đó.",
+} as const;
+
+export const UNREADABLE_CAUSES =
+  "Nguyên nhân thường gặp: không phải file .glb (hoặc file hỏng), file nén kiểu Draco, hoặc thiếu dữ liệu đi kèm.";
+export const SLOW_FILE =
+  "File nặng hoặc phức tạp quá nên đọc quá 15 giây. Hãy giảm số tam giác hoặc dung lượng rồi thử lại.";
+
+/** A file this big is not read at all; one between 10 and 50 MB is read and reported over the limit. */
+export const READ_LIMIT_BYTES = 50 * 1024 * 1024;
+export const tooBigToRead = (bytes: number) =>
+  `File nặng ${(bytes / 1024 / 1024).toFixed(1)} MB nên không được đọc: quy ước chỉ cho phép tối đa 10 MB.`;
+
+/** Where the snippet goes: the mock gives a `.glb` to one SKU only. */
+export const PASTE_STEPS: readonly string[] = [
+  "Chép file .glb vào thư mục public/models/ của dự án.",
+  "Mở src/lib/api/mock-fixtures/design-print-configs.ts. Dữ liệu mẫu hiện chỉ gắn model 3D cho một quy cách, tên trong hằng MOCK_SKU_WITH_MODEL3D.",
+  "Thay nội dung hằng MOCK_MODEL3D bằng đoạn const MOCK_MODEL3D phía dưới.",
+  "Sửa số đo của quy cách đó: thay các dòng size, seamMm, band, material, sector, box (hoặc size, topFoldMm, material với túi) trong dữ liệu của nó. Quy cách kia dùng chung bộ số đo thì đổi theo.",
+  "Muốn thử với quy cách khác: đổi MOCK_SKU_WITH_MODEL3D thành SKU đó, rồi sửa số đo của nó như bước 4.",
+];
