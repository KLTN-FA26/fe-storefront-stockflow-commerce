@@ -0,0 +1,78 @@
+import type { MeasuredFile } from "./model-check-types";
+import type { Mould } from "./model-mould";
+
+const list = (...numbers: number[]) => `[${numbers.join(", ")}]`;
+
+/**
+ * The lines to paste into a row of the mock's print configurations: the arguments of its
+ * `cupTemplate({ ... })` or `bagTemplate({ ... })` and the mock's `MOCK_MODEL3D` constant, worked out so nothing
+ * needs computing by hand. Sizes are the ones read from the file; seam, material and the rest are
+ * the defaults the page lists beside it.
+ */
+export function configSnippet(file: MeasuredFile, mould: Extract<Mould, { ok: true }>): string {
+  const { model } = file;
+  if (model === null) return "";
+  const lines: string[] = [];
+  if (model.kind === "parametric-cup") {
+    const shape = mould.template.printAreas[0]?.shape;
+    const area = mould.template.printAreas[0];
+    lines.push(
+      `size: ${list(model.topDiameterMm, model.bottomDiameterMm, model.heightMm)},`,
+      `seamMm: ${model.seamMm},`,
+      `band: ${list(model.bandTopOffsetMm, model.bandBottomOffsetMm)},`,
+      `material: ${JSON.stringify(model.material)},`,
+    );
+    if (shape?.type === "annular-sector" && area) {
+      lines.push(
+        `sector: { innerMm: ${shape.innerRadiusMm}, outerMm: ${shape.outerRadiusMm}, sweepRad: ${shape.sweepRad} },`,
+        `box: ${list(area.widthMm, area.heightMm)},`,
+      );
+    } else {
+      lines.push("// Thân ly thẳng: khuôn là hình chữ nhật, không có sector và box.");
+    }
+  } else {
+    lines.push(
+      `size: ${list(model.widthMm, model.gussetMm, model.heightMm)},`,
+      `topFoldMm: ${model.topFoldMm},`,
+      `material: ${JSON.stringify(model.material)},`,
+    );
+  }
+  const surfaces = file.parts.map(
+    ({ printAreaCode, meshName }) =>
+      `    { printAreaCode: ${JSON.stringify(printAreaCode)}, meshName: ${JSON.stringify(meshName)} },`,
+  );
+  lines.push(
+    "// Thay hằng MOCK_MODEL3D bằng:",
+    "const MOCK_MODEL3D: Model3dRef = {",
+    `  url: ${JSON.stringify(`/models/${encodeURIComponent(file.fileName)}`)},`,
+    "  surfaces: [",
+    ...surfaces,
+    "  ],",
+    "};",
+  );
+  return lines.join("\n");
+}
+
+/** The figures the system filled in because a file cannot tell them: to confirm with the maker. */
+export function defaultFigures(file: MeasuredFile, mould: Extract<Mould, { ok: true }>) {
+  const { model } = file;
+  const area = mould.template.printAreas[0];
+  if (model === null || area === undefined) return [];
+  const rows: [string, string][] =
+    model.kind === "parametric-cup"
+      ? [
+          ["Mép dán", `${model.seamMm.toFixed(1)} mm`],
+          ["Vành miệng ly", `${model.rimMm.toFixed(1)} mm`],
+          ["Chất liệu", model.material],
+        ]
+      : [
+          ["Phần gập ở miệng túi", `${model.topFoldMm.toFixed(1)} mm`],
+          ["Quai túi", model.handle],
+          ["Chất liệu", model.material],
+        ];
+  rows.push(
+    ["Lề an toàn", `${area.safeMarginMm.toFixed(1)} mm`],
+    ["Tràn lề", `${area.bleedMm.toFixed(1)} mm`],
+  );
+  return rows;
+}
