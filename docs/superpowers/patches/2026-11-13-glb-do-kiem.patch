+import { notFound } from "next/navigation";
+
+import { ModelCheckLoader } from "@/features/product-design/components/model-check/model-check-loader";
+import { DESIGN_API_MOCKED, IS_MOCK } from "@/lib/config";
+
+import type { Metadata } from "next";
+
+export const metadata: Metadata = { title: "Thử model 3D" };
+
+/**
+ * The model-check tool exists while the design module runs on the mock: the condition the
+ * simulation panel uses (`useIsMock() || DESIGN_API_MOCKED`, read on the server here).
+ */
+export default function ModelCheckPage() {
+  if (!IS_MOCK && !DESIGN_API_MOCKED) notFound();
+  return <ModelCheckLoader />;
+}
diff --git a/src/features/product-design/components/model-check/__tests__/grid-texture.test.ts b/src/features/product-design/components/model-check/__tests__/grid-texture.test.ts
