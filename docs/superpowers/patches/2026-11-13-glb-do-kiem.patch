@@ -0,0 +1,185 @@
+import { AlertCircle, AlertTriangle } from "lucide-react";
+
+import { Alert } from "@/components/shared/Alert";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@/components/ui/table";
+
+import type { BagModel, CupModel } from "../../engine";
+import { AXES_NOTE, formatMm, PART_NAME } from "./model-check-messages";
+import type { MeasuredFile, PrintPart, ReportIssue } from "./model-check-types";
+
+const KIND_NAME = { cup: "Ly", bag: "Túi" } as const;
+
+const mm = "tabular-nums";
+
+function sizeRows(model: CupModel | BagModel): [string, string][] {
+  if (model.kind === "parametric-cup") {
+    return [
+      ["Đường kính miệng ly", formatMm(model.topDiameterMm)],
+      ["Đường kính đáy ly", formatMm(model.bottomDiameterMm)],
+      ["Chiều cao", formatMm(model.heightMm)],
+      ["Dải in cách miệng", formatMm(model.bandTopOffsetMm)],
+      ["Dải in cách đáy", formatMm(model.bandBottomOffsetMm)],
+    ];
+  }
+  return [
+    ["Chiều rộng", formatMm(model.widthMm)],
+    ["Độ sâu hông", formatMm(model.gussetMm)],
+    ["Chiều cao", formatMm(model.heightMm)],
+  ];
+}
+
+function partSize(part: PrintPart): string {
+  const shape = part.shape;
+  if (shape === null) return "Chưa đọc được số đo";
+  if (shape.kind === "band") {
+    return `Miệng ${formatMm(shape.topDiameterMm)}, đáy ${formatMm(shape.bottomDiameterMm)}, cao ${formatMm(shape.topYMm - shape.bottomYMm)}`;
+  }
+  return `${formatMm(shape.widthMm)} × ${formatMm(shape.heightMm)}`;
+}
+
+function IssueRow({ issue }: { issue: ReportIssue }) {
+  const isError = issue.level === "error";
+  const Icon = isError ? AlertCircle : AlertTriangle;
+  return (
+    <li className="border-border-default flex gap-3 border-b py-3 last:border-b-0">
+      <Icon
+        aria-hidden
+        className={
+          isError ? "text-danger mt-0.5 size-4 shrink-0" : "text-warning mt-0.5 size-4 shrink-0"
+        }
+      />
+      <div className="min-w-0 space-y-1 text-sm">
+        <p>
+          <strong className={isError ? "text-danger" : "text-warning"}>
+            {isError ? "Lỗi" : "Cảnh báo"}
+          </strong>
+          <span className="text-ink-primary">{`: ${issue.message}`}</span>
+        </p>
+        {issue.meshName !== undefined && (
+          <p className="text-ink-tertiary text-xs">
+            Phần trong file: <span className="font-mono">{issue.meshName}</span>
+          </p>
+        )}
+      </div>
+    </li>
+  );
+}
+
+/** What was read from the file: its kind, the problems found, the sizes. */
+export function ModelCheckReport({
+  file,
+  extraIssues,
+  defaults,
+}: {
+  file: MeasuredFile;
+  /** Warnings from the figures the person typed in, and the part-by-part comparison with the mould. */
+  extraIssues: ReportIssue[];
+  /** The figures the system filled in, to confirm with the maker; null when there are none. */
+  defaults: [string, string][] | null;
+}) {
+  const issues = [...file.issues, ...extraIssues];
+  const errors = issues.filter((issue) => issue.level === "error").length;
+  const heading =
+    file.kind === null ? "Chưa nhận ra loại sản phẩm" : `Nhận ra: ${KIND_NAME[file.kind]}`;
+
+  return (
+    <section aria-labelledby="model-check-report" className="space-y-4">
+      <h2 id="model-check-report" className="font-display text-ink-primary text-lg font-semibold">
+        {heading}
+      </h2>
+
+      {issues.length === 0 ? (
+        <Alert tone="info">File đạt các bước kiểm: không có lỗi hay cảnh báo.</Alert>
+      ) : (
+        <div className="bg-bg-surface border-border-default rounded-[var(--r-lg)] border p-[var(--card-pad)] shadow-[var(--sh-sm)]">
+          <h3 className="text-ink-primary text-sm font-semibold">
+            {errors > 0
+              ? `Có ${errors} lỗi cần sửa trong Blender`
+              : "Không có lỗi chặn, nhưng có cảnh báo"}
+          </h3>
+          <p className="text-ink-tertiary mt-1 text-xs">{AXES_NOTE}</p>
+          <ul aria-label="Lỗi và cảnh báo" className="mt-1">
+            {issues.map((issue, index) => (
+              <IssueRow key={`${issue.code}-${issue.meshName ?? ""}-${index}`} issue={issue} />
+            ))}
+          </ul>
+        </div>
+      )}
+
+      {file.model !== null && (
+        <div className="bg-bg-surface border-border-default rounded-[var(--r-lg)] border p-[var(--card-pad)] shadow-[var(--sh-sm)]">
+          <Table>
+            <caption className="text-ink-primary pb-2 text-left text-sm font-semibold">
+              Số đo đọc được từ file
+            </caption>
+            <TableBody>
+              {sizeRows(file.model).map(([label, value]) => (
+                <TableRow key={label}>
+                  <TableCell className="text-ink-secondary">{label}</TableCell>
+                  <TableCell className={`${mm} text-ink-primary text-right`}>{value}</TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        </div>
+      )}
+
+      {defaults !== null && defaults.length > 0 && (
+        <div className="bg-bg-surface border-border-default rounded-[var(--r-lg)] border p-[var(--card-pad)] shadow-[var(--sh-sm)]">
+          <p className="text-ink-secondary pb-2 text-sm">
+            Các số dưới đây không đọc được từ file: hệ thống tự điền số mặc định, hãy xác nhận lại
+            với nhà sản xuất hoặc nhà in.
+          </p>
+          <Table>
+            <caption className="text-ink-primary pb-2 text-left text-sm font-semibold">
+              Số hệ thống tự điền (mặc định)
+            </caption>
+            <TableBody>
+              {defaults.map(([label, value]) => (
+                <TableRow key={label}>
+                  <TableCell className="text-ink-secondary">{label}</TableCell>
+                  <TableCell className={`${mm} text-ink-primary text-right`}>{value}</TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        </div>
+      )}
+
+      {file.parts.length > 0 && (
+        <div className="bg-bg-surface border-border-default rounded-[var(--r-lg)] border p-[var(--card-pad)] shadow-[var(--sh-sm)]">
+          <Table>
+            <caption className="text-ink-primary pb-2 text-left text-sm font-semibold">
+              Từng phần in trong file
+            </caption>
+            <TableHeader>
+              <TableRow>
+                <TableHead>Phần in</TableHead>
+                <TableHead>Tên trong file</TableHead>
+                <TableHead>Số đo</TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {file.parts.map((part, index) => (
+                <TableRow key={`${index}-${part.printAreaCode}-${part.meshName}`}>
+                  <TableCell className="text-ink-primary">
+                    {PART_NAME[part.printAreaCode]}
+                  </TableCell>
+                  <TableCell className="text-ink-secondary font-mono">{part.meshName}</TableCell>
+                  <TableCell className={`${mm} text-ink-primary`}>{partSize(part)}</TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/src/features/product-design/components/model-check/model-check-screen.tsx b/src/features/product-design/components/model-check/model-check-screen.tsx
