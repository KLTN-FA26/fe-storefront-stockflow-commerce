+/** A flat face in a plane of x or z, base at y = 0. */
+function facePlaneQuad(
+  axis: "x" | "z",
+  plane: number,
+  width: number,
+  height: number,
+): BufferGeometry {
+  const w = width / 2;
+  const at = (along: number, y: number) => (axis === "z" ? [along, y, plane] : [plane, y, along]);
+  const g = new BufferGeometry();
+  g.setAttribute(
+    "position",
+    new BufferAttribute(
+      new Float32Array([at(-w, 0), at(w, 0), at(w, height), at(-w, height)].flat()),
+      3,
+    ),
+  );
+  g.setIndex([0, 1, 2, 0, 2, 3]);
+  return g;
+}
