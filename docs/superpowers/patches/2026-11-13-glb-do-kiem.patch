@@ -0,0 +1,160 @@
+"use client";
+
+import { Upload } from "lucide-react";
+import { useId, useState, type DragEvent } from "react";
+
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { cn } from "@/lib/cn";
+
+import type { NominalSizes } from "../../engine";
+
+/** The `.glb` box: a file input behind a label that covers it, and a drag highlight for files. */
+export function ModelCheckDropzone({
+  busy,
+  onFile,
+}: {
+  busy: boolean;
+  onFile: (file: File) => void;
+}) {
+  const [dragging, setDragging] = useState(false);
+  const inputId = useId();
+  const hintId = useId();
+
+  const onDrop = (event: DragEvent) => {
+    event.preventDefault();
+    setDragging(false);
+    const file = event.dataTransfer.files[0];
+    if (file && !busy) onFile(file);
+  };
+
+  return (
+    <div
+      onDragOver={(event) => {
+        if (!Array.from(event.dataTransfer.types).includes("Files")) return;
+        // Taken even while busy: a file that is not swallowed makes the browser open it and leave.
+        event.preventDefault();
+        if (!busy) setDragging(true);
+      }}
+      onDragLeave={() => setDragging(false)}
+      onDrop={onDrop}
+      className={cn(
+        "border-border-strong focus-within:ring-accent relative flex min-h-32 flex-col items-center justify-center gap-1 rounded-[var(--r-lg)] border-2 border-dashed p-4 text-center focus-within:ring-2",
+        dragging ? "bg-bg-muted border-accent" : "bg-bg-surface",
+        busy && "opacity-60",
+      )}
+    >
+      <input
+        id={inputId}
+        type="file"
+        accept=".glb,model/gltf-binary"
+        disabled={busy}
+        aria-describedby={hintId}
+        className="sr-only"
+        onChange={(event) => {
+          const file = event.target.files?.[0];
+          event.target.value = ""; // the same file can be chosen again
+          if (file) onFile(file);
+        }}
+      />
+      <Upload aria-hidden className="text-accent size-6" />
+      <label
+        htmlFor={inputId}
+        className="text-ink-primary cursor-pointer text-sm font-medium after:absolute after:inset-0"
+      >
+        Chọn hoặc kéo thả file .glb
+      </label>
+      <p id={hintId} className="text-ink-tertiary text-xs">
+        File được đọc ngay trên máy của bạn, không gửi đi đâu.
+      </p>
+    </div>
+  );
+}
+
+export type NominalKey = keyof NominalSizes;
+
+/** The figures a kind of product can be cross-checked on, in the order they are asked. */
+export const NOMINAL_FIELDS: Record<"cup" | "bag", readonly { key: NominalKey; label: string }[]> =
+  {
+    cup: [
+      { key: "topDiameterMm", label: "Đường kính miệng ly (mm)" },
+      { key: "bottomDiameterMm", label: "Đường kính đáy ly (mm)" },
+      { key: "heightMm", label: "Chiều cao (mm)" },
+    ],
+    bag: [
+      { key: "widthMm", label: "Chiều rộng (mm)" },
+      { key: "gussetMm", label: "Độ sâu hông (mm)" },
+      { key: "heightMm", label: "Chiều cao (mm)" },
+    ],
+  };
+
+export const NOMINAL_INVALID = "Nhập một số lớn hơn 0.";
+
+/** The typed figures as numbers: blank ones are left out, others must be positive numbers. */
+export function parseNominal(values: Partial<Record<NominalKey, string>>): {
+  nominal: NominalSizes;
+  invalid: Set<NominalKey>;
+} {
+  const nominal: NominalSizes = {};
+  const invalid = new Set<NominalKey>();
+  for (const [key, text] of Object.entries(values) as [NominalKey, string][]) {
+    const trimmed = text.trim();
+    if (trimmed === "") continue;
+    const value = Number(trimmed.replace(",", "."));
+    if (Number.isFinite(value) && value > 0) nominal[key] = value;
+    else invalid.add(key);
+  }
+  return { nominal, invalid };
+}
+
+/** The optional cross-check: the maker's figures, typed in, are compared with those read. */
+export function NominalInputs({
+  kind,
+  values,
+  invalid,
+  onChange,
+}: {
+  kind: "cup" | "bag";
+  values: Partial<Record<NominalKey, string>>;
+  invalid: ReadonlySet<NominalKey>;
+  onChange: (key: NominalKey, text: string) => void;
+}) {
+  const prefix = useId();
+  return (
+    <fieldset className="space-y-3">
+      <legend className="text-ink-primary text-sm font-semibold">
+        Số trong bảng thông số của nhà sản xuất (không bắt buộc)
+      </legend>
+      <p className="text-ink-secondary text-sm">
+        Gõ vào để so với số đo đọc được. Ô để trống thì bỏ qua. Lệch quá 1 mm sẽ có cảnh báo.
+      </p>
+      <div className="grid gap-3 sm:grid-cols-3">
+        {NOMINAL_FIELDS[kind].map(({ key, label }) => {
+          const id = `${prefix}-${key}`;
+          const bad = invalid.has(key);
+          return (
+            <div key={key} className="space-y-1.5">
+              <Label htmlFor={id}>{label}</Label>
+              <Input
+                id={id}
+                type="text"
+                inputMode="decimal"
+                autoComplete="off"
+                value={values[key] ?? ""}
+                aria-invalid={bad}
+                aria-describedby={bad ? `${id}-error` : undefined}
+                className="h-11 tabular-nums"
+                onChange={(event) => onChange(key, event.target.value)}
+              />
+              {bad && (
+                <p id={`${id}-error`} className="text-danger text-xs">
+                  {NOMINAL_INVALID}
+                </p>
+              )}
+            </div>
+          );
+        })}
+      </div>
+    </fieldset>
+  );
+}
diff --git a/src/features/product-design/components/model-check/model-check-dieline.tsx b/src/features/product-design/components/model-check/model-check-dieline.tsx
