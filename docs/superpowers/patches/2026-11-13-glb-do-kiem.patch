diff --git a/src/features/product-design/engine/model3d/issues.ts b/src/features/product-design/engine/model3d/issues.ts
new file mode 100644
index 0000000..1130855
--- /dev/null
+++ b/src/features/product-design/engine/model3d/issues.ts
@@ -0,0 +1,144 @@
+import type { BagModel, CupModel } from "../template/schema";
+
+/**
+ * What can be wrong with a `.glb` model, in plain Vietnamese (spec §5).
+ * Errors block the model (the viewer keeps the number-built mould); warnings do not.
+ */
+export type ModelIssueCode =
+  | "NO_PRINT_MESH"
+  | "DUPLICATE_PRINT_MESH"
+  | "MIXED_KINDS"
+  | "BAD_UNITS"
+  | "NOT_REVOLVED"
+  | "TOO_COARSE"
+  | "NOT_PLANAR"
+  | "NOT_RECTANGULAR"
+  | "TOO_MANY_TRIANGLES"
+  | "FILE_TOO_LARGE"
+  | "NOT_FACING_FRONT"
+  | "BASE_NOT_AT_ZERO"
+  | "FACES_INWARD"
+  | "PRINT_NAME_NEAR_MISS"
+  | "INVALID_GEOMETRY"
+  | "MULTI_MATERIAL_PRINT_MESH"
+  | "GUSSET_MISMATCH"
+  | "BAG_MODEL_INCOMPLETE"
+  | "NOMINAL_MISMATCH";
+
+export type ModelIssue = {
+  code: ModelIssueCode;
+  level: "error" | "warning";
+  message: string;
+  meshName?: string;
+};
+
+export const MODEL_ISSUE_LEVEL: Readonly<Record<ModelIssueCode, ModelIssue["level"]>> = {
+  NO_PRINT_MESH: "error",
+  DUPLICATE_PRINT_MESH: "error",
+  MIXED_KINDS: "error",
+  BAD_UNITS: "error",
+  NOT_REVOLVED: "error",
+  TOO_COARSE: "error",
+  NOT_PLANAR: "error",
+  NOT_RECTANGULAR: "error",
+  TOO_MANY_TRIANGLES: "error",
+  FILE_TOO_LARGE: "error",
+  NOT_FACING_FRONT: "warning",
+  BASE_NOT_AT_ZERO: "warning",
+  FACES_INWARD: "warning",
+  PRINT_NAME_NEAR_MISS: "warning",
+  INVALID_GEOMETRY: "error",
+  MULTI_MATERIAL_PRINT_MESH: "error",
+  GUSSET_MISMATCH: "warning",
+  BAG_MODEL_INCOMPLETE: "warning",
+  NOMINAL_MISMATCH: "warning",
+};
+
+export function modelIssue(code: ModelIssueCode, message: string, meshName?: string): ModelIssue {
+  return meshName === undefined
+    ? { code, level: MODEL_ISSUE_LEVEL[code], message }
+    : { code, level: MODEL_ISSUE_LEVEL[code], message, meshName };
+}
+
+const mm = (n: number) => `${Math.round(n * 10) / 10} mm`;
+
+export const issueMessages = {
+  noPrintMesh: () =>
+    "Không tìm thấy phần in nào. Model cần ít nhất một object tên print:BODY (ly) hoặc print:FRONT, print:BACK, print:LEFT, print:RIGHT (túi).",
+  invalidGeometry: (name: string, reason: string) => `${name} không dùng được: ${reason}.`,
+  coneCloses: (name: string, where: "base" | "rim") =>
+    where === "base"
+      ? `Mặt nón của ${name} đóng lại trước khi tới đáy (Y = 0), không dựng được cả ly từ dải này.`
+      : `Mặt nón của ${name} đóng lại trước khi tới miệng ly, không dựng được cả ly từ dải này.`,
+  facesInward: (name: string) =>
+    `Mặt của ${name} đang quay vào trong nên sẽ hiện như một lỗ trên model. Trong Blender: vào Edit Mode, chọn tất cả (A), rồi Mesh > Normals > Recalculate Outside.`,
+  nameNearMiss: (name: string, expected: string) =>
+    `Object "${name}" trông như phần in nhưng tên chưa đúng, nên không được nhận. Hãy đặt tên chính xác là "${expected}" (Blender tự thêm .001 khi hai object trùng tên).`,
+  printOnParent: (name: string) =>
+    `${name} đang đặt trên một object cha chứa các phần in khác. Hãy đặt tên print: cho chính object mesh, không đặt cho object chứa chúng.`,
+  multiMaterial: (name: string) =>
+    `${name} có nhiều vật liệu: dùng một vật liệu cho phần in (một object chỉ gồm một mesh).`,
+  gussetMismatch: (sideName: string, sideMm: number, planesMm: number) =>
+    `Độ sâu hông đo từ ${sideName} là ${mm(sideMm)}, nhưng khoảng cách giữa mặt trước và mặt sau là ${mm(planesMm)} (cho phép lệch 0,5 mm). Số đo lấy theo mặt hông.`,
+  bagIncomplete: () =>
+    "Chưa đủ mặt để đo cả túi: cần print:FRONT và print:BACK, hoặc một mặt hông (print:LEFT / print:RIGHT) cùng mặt trước hoặc sau. Kích thước từng mặt vẫn đọc được.",
+  duplicatePrintMesh: (name: string) =>
+    `Có nhiều hơn một object tên ${name}. Mỗi vùng in chỉ được có một object.`,
+  mixedKinds: () =>
+    "Model vừa có print:BODY (ly) vừa có mặt túi (print:FRONT, BACK, LEFT, RIGHT). Mỗi model chỉ là ly hoặc túi.",
+  badUnits: (name: string, heightMm: number, [min, max]: readonly [number, number]) =>
+    `Chiều cao của ${name} đọc ra ${mm(heightMm)}, ngoài khoảng ${min}–${max} mm. Có thể file dựng sai đơn vị (cần 1 đơn vị = 1 mét).`,
+  notRevolved: (name: string, detail: string) =>
+    `${name} không phải mặt tròn xoay khép kín quanh trục Y đi qua gốc tọa độ (${detail}; cho phép 0,5 mm). Phần in của ly phải là một vòng khép kín hình nón cụt có tâm ở trục Y.`,
+  tooCoarse: (name: string, edges: number, min: number) =>
+    `${name} chỉ có ${edges} cạnh quanh thân, cần ít nhất ${min}. Hãy tăng số cạnh để thân ly tròn.`,
+  notPlanar: (name: string, deviationMm: number) =>
+    `${name} không phẳng (các điểm lệch nhau ${mm(deviationMm)}, cho phép 0,5 mm). Mặt túi phải nằm trên một mặt phẳng, mặt trước/sau vuông góc trục Z, mặt hông vuông góc trục X.`,
+  notRectangular: (name: string) =>
+    `${name} không phải hình chữ nhật (sai số quá 0,5 mm). Mặt in của túi phải là hình chữ nhật.`,
+  tooManyTriangles: (count: number, max: number) =>
+    `Model có ${count} tam giác, nhiều hơn mức cho phép ${max}. Hãy giảm độ chi tiết của model.`,
+  fileTooLarge: (bytes: number, maxBytes: number) =>
+    `File nặng ${Math.round((bytes / 1024 / 1024) * 10) / 10} MB, vượt mức ${maxBytes / 1024 / 1024} MB.`,
+  notFacingFront: (name: string) => `${name} đang quay về -Z. Mặt trước của túi phải nhìn về +Z.`,
+  baseNotAtZero: (minYMm: number) =>
+    `Đáy model nằm ở Y = ${mm(minYMm)}, cần ở Y = 0. Viewer sẽ đặt model lệch so với mặt sàn.`,
+};
+
+/** Numbers a user may type to cross-check what was measured (all optional). */
+export type NominalSizes = Partial<
+  Record<"topDiameterMm" | "bottomDiameterMm" | "heightMm" | "widthMm" | "gussetMm", number>
+>;
+
+const NOMINAL_LABEL: Readonly<Record<keyof NominalSizes, string>> = {
+  topDiameterMm: "Đường kính miệng",
+  bottomDiameterMm: "Đường kính đáy",
+  heightMm: "Chiều cao",
+  widthMm: "Chiều rộng",
+  gussetMm: "Độ sâu hông",
+};
+
+export const NOMINAL_TOLERANCE_MM = 1;
+
+/** A warning for each figure that differs from the nominal by more than 1 mm (spec §5). */
+export function compareWithNominal(
+  model: CupModel | BagModel,
+  nominal: NominalSizes,
+): ModelIssue[] {
+  const measured: Record<string, unknown> = { ...model };
+  const issues: ModelIssue[] = [];
+  for (const key of Object.keys(NOMINAL_LABEL) as (keyof NominalSizes)[]) {
+    const wanted = nominal[key];
+    const actual = measured[key];
+    if (wanted === undefined || typeof actual !== "number") continue;
+    if (Math.abs(actual - wanted) > NOMINAL_TOLERANCE_MM + 1e-9) {
+      issues.push(
+        modelIssue(
+          "NOMINAL_MISMATCH",
+          `${NOMINAL_LABEL[key]} đo được ${mm(actual)}, lệch ${mm(Math.abs(actual - wanted))} so với số danh nghĩa ${mm(wanted)} (cho phép ${NOMINAL_TOLERANCE_MM} mm).`,
+        ),
+      );
+    }
+  }
+  return issues;
+}
diff --git a/src/features/product-design/engine/model3d/load.ts b/src/features/product-design/engine/model3d/load.ts
new file mode 100644
index 0000000..4d0191a
--- /dev/null
+++ b/src/features/product-design/engine/model3d/load.ts
@@ -0,0 +1,279 @@
+import { type BufferGeometry, Camera, Light, Mesh, type Group } from "three";
+
+import { disposeTree } from "./dispose";
+import type { ModelIssue } from "./issues";
+
+/**
+ * Loading a `.glb` from a URL goes through a small cache of the BYTES (never of parsed trees: a
+ * scene takes ownership of the tree it is given, so every `loadGlb` call parses its own copy).
+ *
+ * - One shared download per URL at a time. It is not tied to any caller's abort signal: a caller that
+ *   aborts stops waiting (`ABORTED`) while the download goes on for the others and for the cache.
+ *   Its 15 s limit runs from when the download started; each call's parse has its own 15 s.
+ * - The bytes of a successful download are kept for the last 4 URLs (least recently used dropped).
+ *   Parsing uses a copy of the kept buffer, so the cache entry is never touched by a parser.
+ * - A failed download (HTTP error, network error, the 15 s timeout) is remembered for 60 s: a call of
+ *   the same URL in that window fails at once with the same code and reason, without a request.
+ *   It is remembered only briefly so that a flaky connection recovers without a page reload, while
+ *   a set submission of N designs does not make N slow requests (and N times 15 s of waiting) to a
+ *   file that is down. An abort is never remembered. An `ArrayBuffer` source bypasses all of this.
+ */
+
+export type Model3dErrorCode =
+  "LOAD_FAILED" | "ABORTED" | "MESH_MISSING" | "INVALID_MODEL" | "MODEL_MISMATCH";
+
+/** Why a `LOAD_FAILED` happened. */
+export type Model3dLoadReason = "timeout" | "http" | "network" | "parse";
+
+/** Why a `.glb` could not become a scene; `issues` carries the measurement's findings. */
+export class Model3dError extends Error {
+  readonly code: Model3dErrorCode;
+  readonly issues?: ModelIssue[];
+  /** Set for `LOAD_FAILED`. */
+  readonly reason?: Model3dLoadReason;
+
+  constructor(
+    code: Model3dErrorCode,
+    message: string,
+    issues?: ModelIssue[],
+    reason?: Model3dLoadReason,
+  ) {
+    super(message);
+    this.name = "Model3dError";
+    this.code = code;
+    if (issues) this.issues = issues;
+    if (reason) this.reason = reason;
+  }
+}
+
+/** A glTF is in metres; the engine works in millimetres. */
+export const MM_PER_METRE = 1000;
+/** How long a download, and separately a parse, may take before it fails (spec 2026-11-13 §8). */
+export const LOAD_TIMEOUT_MS = 15_000;
+/** Where `loadGlb` leaves the size of the file, for the checks of `measureModel`. */
+export const BYTE_LENGTH_KEY = "glbByteLength";
+/** Bytes of this many URLs are kept. */
+export const KEPT_URLS = 4;
+/** A failed download is remembered this long. */
+export const FAILURE_MEMORY_MS = 60_000;
+
+/**
+ * Scales the whole tree from metres to millimetres and bakes it (exported for tests, not part of the
+ * public barrel): every node's translation and every geometry (once,
+ * also when shared) is multiplied by 1000, node rotations and scales are left alone. That is the
+ * same as scaling the world by 1000, so every mesh keeps its place and its `matrixWorld` is in mm.
+ * Morph targets, skins and instanced meshes are not scaled: the file convention forbids animation.
+ */
+export function bakeMillimetres(root: Group) {
+  const factor = MM_PER_METRE;
+  const scaled = new Set<BufferGeometry>();
+  const drop: (Light | Camera)[] = [];
+  root.traverse((object) => {
+    object.position.multiplyScalar(factor);
+    if (object instanceof Mesh && !scaled.has(object.geometry)) {
+      scaled.add(object.geometry);
+      object.geometry.scale(factor, factor, factor);
+    }
+    // The viewer lights the scene itself.
+    if (object instanceof Light || object instanceof Camera) drop.push(object);
+  });
+  drop.forEach((object) => object.removeFromParent());
+  root.updateMatrixWorld(true);
+}
+
+const messageOf = (error: unknown) => (error instanceof Error ? error.message : String(error));
+
+const timeoutError = (reason: string) =>
+  new Model3dError(
+    "LOAD_FAILED",
+    `Nạp model 3D quá thời gian chờ 15 giây (${reason})`,
+    undefined,
+    "timeout",
+  );
+
+type Download = { promise: Promise<ArrayBuffer>; cancel: () => void };
+type Failure = { code: "LOAD_FAILED"; message: string; reason?: Model3dLoadReason; until: number };
+
+const downloads = new Map<string, Download>();
+const kept = new Map<string, ArrayBuffer>();
+const failures = new Map<string, Failure>();
+let generation = 0;
+
+/** Empties the byte cache, the remembered failures and cancels running downloads (tests only). */
+export function resetGlbCacheForTests() {
+  generation += 1;
+  downloads.forEach((download) => download.cancel());
+  downloads.clear();
+  kept.clear();
+  failures.clear();
+}
+
+function startDownload(url: string): Download {
+  const mine = generation;
+  const control = new AbortController();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => {
+      control.abort();
+      reject(timeoutError("tải file"));
+    }, LOAD_TIMEOUT_MS);
+  });
+  timeout.catch(() => undefined);
+
+  const run = async (): Promise<ArrayBuffer> => {
+    try {
+      const bytes = await Promise.race([
+        (async () => {
+          const response = await fetch(url, { signal: control.signal });
+          if (!response.ok) {
+            throw new Model3dError(
+              "LOAD_FAILED",
+              `Không tải được file .glb (HTTP ${response.status})`,
+              undefined,
+              "http",
+            );
+          }
+          return response.arrayBuffer();
+        })(),
+        timeout,
+      ]);
+      if (mine === generation) {
+        kept.delete(url);
+        kept.set(url, bytes);
+        while (kept.size > KEPT_URLS) kept.delete(kept.keys().next().value!);
+      }
+      return bytes;
+    } catch (error) {
+      const failure =
+        error instanceof Model3dError
+          ? error
+          : new Model3dError(
+              "LOAD_FAILED",
+              `Không tải được file .glb: ${messageOf(error)}`,
+              undefined,
+              "network",
+            );
+      if (mine === generation) {
+        failures.set(url, {
+          code: "LOAD_FAILED",
+          message: failure.message,
+          ...(failure.reason ? { reason: failure.reason } : {}),
+          until: Date.now() + FAILURE_MEMORY_MS,
+        });
+      }
+      throw failure;
+    } finally {
+      clearTimeout(timer);
+      if (mine === generation) downloads.delete(url);
+    }
+  };
+  const promise = run();
+  promise.catch(() => undefined);
+  return { promise, cancel: () => control.abort() };
+}
+
+/** The bytes of a URL: kept, remembered as failed, or one shared download. */
+function bytesOf(url: string): Promise<ArrayBuffer> {
+  const hit = kept.get(url);
+  if (hit) {
+    kept.delete(url);
+    kept.set(url, hit);
+    return Promise.resolve(hit);
+  }
+  const failure = failures.get(url);
+  if (failure) {
+    if (Date.now() < failure.until) {
+      return Promise.reject(
+        new Model3dError(failure.code, failure.message, undefined, failure.reason),
+      );
+    }
+    failures.delete(url);
+  }
+  let download = downloads.get(url);
+  if (!download) {
+    download = startDownload(url);
+    downloads.set(url, download);
+  }
+  return download.promise;
+}
+
+/**
+ * Loads a `.glb` (a URL, or its bytes) into a three `Group` in millimetres. A URL goes through the
+ * byte cache described at the top of this file. three's loader is imported on demand; no Draco, KTX2
+ * or Meshopt decoder is set up, so a file that needs one fails as `LOAD_FAILED` (`reason: "parse"`),
+ * like a network error (`"network"`), an HTTP error (`"http"`), or a download or parse longer than
+ * 15 s (`"timeout"`). An aborted `signal` rejects with `ABORTED` (a tree parsed after that is freed).
+ */
+export async function loadGlb(
+  source: string | ArrayBuffer,
+  opts: { signal?: AbortSignal } = {},
+): Promise<Group> {
+  const aborted = () => new Model3dError("ABORTED", "Việc nạp model 3D đã bị huỷ");
+  if (opts.signal?.aborted) throw aborted();
+
+  const work = new AbortController();
+  let timedOut = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const stop = () => work.abort();
+  opts.signal?.addEventListener("abort", stop, { once: true });
+  const interruption = () => (timedOut ? timeoutError("phân tích file") : aborted());
+  const interrupted = new Promise<never>((_, reject) => {
+    work.signal.addEventListener("abort", () => reject(interruption()), { once: true });
+  });
+  interrupted.catch(() => undefined);
+  const until = <T>(step: Promise<T>): Promise<T> => Promise.race([step, interrupted]);
+
+  try {
+    const { GLTFLoader } = await until(import("three/addons/loaders/GLTFLoader.js"));
+    // A URL's kept buffer is parsed through a copy; a caller's own buffer is used as it is.
+    const bytes = typeof source === "string" ? (await until(bytesOf(source))).slice(0) : source;
+
+    // The parse has its own limit, from when it starts.
+    timer = setTimeout(() => {
+      timedOut = true;
+      work.abort();
+    }, LOAD_TIMEOUT_MS);
+    const gltf = await until(
+      new Promise<{ scene?: Group }>((resolve, reject) => {
+        try {
+          new GLTFLoader().parse(
+            bytes,
+            "",
+            (parsed) => {
+              // Aborted while parsing: nothing will use this tree, free it now.
+              if (work.signal.aborted && parsed.scene) disposeTree(parsed.scene);
+              resolve(parsed);
+            },
+            reject,
+          );
+        } catch (error) {
+          reject(error);
+        }
+      }),
+    );
+    const root = gltf.scene;
+    if (!root) {
+      throw new Model3dError("LOAD_FAILED", "File .glb không có cảnh nào", undefined, "parse");
+    }
+    if (work.signal.aborted) {
+      disposeTree(root);
+      throw interruption();
+    }
+
+    bakeMillimetres(root);
+    root.userData[BYTE_LENGTH_KEY] = bytes.byteLength;
+    return root;
+  } catch (error) {
+    if (error instanceof Model3dError) throw error;
+    if (work.signal.aborted) throw interruption();
+    throw new Model3dError(
+      "LOAD_FAILED",
+      `Không nạp được file .glb: ${messageOf(error)}`,
+      undefined,
+      "parse",
+    );
+  } finally {
+    clearTimeout(timer);
+    opts.signal?.removeEventListener("abort", stop);
+  }
+}
diff --git a/src/features/product-design/engine/model3d/measure-bag.ts b/src/features/product-design/engine/model3d/measure-bag.ts
new file mode 100644
index 0000000..fd868c5
--- /dev/null
+++ b/src/features/product-design/engine/model3d/measure-bag.ts
@@ -0,0 +1,156 @@
+import { Vector3 } from "three";
+
+import type { BagModel } from "../template/schema";
+import { issueMessages, type ModelIssue, modelIssue } from "./issues";
+import {
+  BAG_CODES,
+  BAG_HEIGHT_RANGE_MM,
+  type BagCode,
+  type FaceShape,
+  type ModelDefaults,
+  round2,
+  SHAPE_TOLERANCE_MM,
+} from "./measure-types";
+import { mostlyInward } from "./measure-winding";
+
+/** The direction each face must look in (the front is +Z). */
+const OUTWARD: Record<BagCode, Vector3> = {
+  FRONT: new Vector3(0, 0, 1),
+  BACK: new Vector3(0, 0, -1),
+  RIGHT: new Vector3(1, 0, 0),
+  LEFT: new Vector3(-1, 0, 0),
+};
+
+export type FaceInput = { name: string; points: Vector3[]; triangles: ArrayLike<number> };
+
+function range(values: number[]): [number, number] {
+  let lo = Infinity;
+  let hi = -Infinity;
+  for (const v of values) {
+    if (v < lo) lo = v;
+    if (v > hi) hi = v;
+  }
+  return [lo, hi];
+}
+
+/** FRONT/BACK lie in a plane of constant z, LEFT/RIGHT in a plane of constant x; each is a rectangle. */
+function measureFace(
+  code: BagCode,
+  { name, points }: FaceInput,
+): { shape: FaceShape | null; issue: ModelIssue | null } {
+  const alongZ = code === "FRONT" || code === "BACK";
+  const fail = (issue: ModelIssue) => ({ shape: null, issue });
+
+  const [n0, n1] = range(points.map((p) => (alongZ ? p.z : p.x)));
+  if (n1 - n0 > SHAPE_TOLERANCE_MM) {
+    return fail(modelIssue("NOT_PLANAR", issueMessages.notPlanar(name, n1 - n0), name));
+  }
+
+  const flat = points.map((p) => ({ a: alongZ ? p.x : p.z, y: p.y }));
+  const [a0, a1] = range(flat.map((q) => q.a));
+  const [y0, y1] = range(flat.map((q) => q.y));
+  const near = (v: number, edge: number) => Math.abs(v - edge) <= SHAPE_TOLERANCE_MM;
+  // A flat face with vertices inside (loop cuts) is still a rectangle: what makes it one is a
+  // vertex at each of the four corners of its bounding box (and, below, a real width and height).
+  const hasCorner = (a: number, y: number) => flat.some((q) => near(q.a, a) && near(q.y, y));
+  const cornered = hasCorner(a0, y0) && hasCorner(a0, y1) && hasCorner(a1, y0) && hasCorner(a1, y1);
+  const height = y1 - y0;
+  const [minH, maxH] = BAG_HEIGHT_RANGE_MM;
+  // sizes in metres read as millimetres are a units problem, whatever the face looks like
+  if (cornered && (height < minH || height > maxH)) {
+    return fail(
+      modelIssue("BAD_UNITS", issueMessages.badUnits(name, height, BAG_HEIGHT_RANGE_MM), name),
+    );
+  }
+  if (!cornered || a1 - a0 <= SHAPE_TOLERANCE_MM || height <= SHAPE_TOLERANCE_MM) {
+    return fail(modelIssue("NOT_RECTANGULAR", issueMessages.notRectangular(name), name));
+  }
+  return {
+    shape: {
+      kind: "face",
+      widthMm: round2(a1 - a0),
+      heightMm: round2(height),
+      bottomYMm: round2(y0),
+      offsetMm: round2((n0 + n1) / 2),
+      centreMm: round2((a0 + a1) / 2),
+    },
+    issue: null,
+  };
+}
+
+export type BagAnalysis = {
+  /** one entry per face given; null when that face failed its own checks */
+  shapes: Partial<Record<BagCode, FaceShape | null>>;
+  model: BagModel | null;
+  issues: ModelIssue[];
+};
+
+export function measureBag(
+  faces: Partial<Record<BagCode, FaceInput>>,
+  defaults: ModelDefaults,
+): BagAnalysis {
+  const issues: ModelIssue[] = [];
+  const shapes: BagAnalysis["shapes"] = {};
+  for (const code of BAG_CODES) {
+    const face = faces[code];
+    if (!face) continue;
+    const { shape, issue } = measureFace(code, face);
+    shapes[code] = shape;
+    if (issue) issues.push(issue);
+    if (shape && mostlyInward(face.points, face.triangles, () => OUTWARD[code])) {
+      issues.push(modelIssue("FACES_INWARD", issueMessages.facesInward(face.name), face.name));
+    }
+  }
+  if (issues.some((i) => i.level === "error")) return { shapes, model: null, issues };
+
+  // the front face looks towards +z; BACK is only checked when FRONT is absent
+  if (shapes.FRONT && shapes.FRONT.offsetMm <= 0) {
+    const name = faces.FRONT?.name ?? "print:FRONT";
+    issues.push(modelIssue("NOT_FACING_FRONT", issueMessages.notFacingFront(name), name));
+  } else if (!shapes.FRONT && shapes.BACK && shapes.BACK.offsetMm >= 0) {
+    const name = faces.BACK?.name ?? "print:BACK";
+    issues.push(modelIssue("NOT_FACING_FRONT", issueMessages.notFacingFront(name), name));
+  }
+
+  const widthFace = shapes.FRONT ?? shapes.BACK;
+  const sideCode: BagCode | null = shapes.LEFT ? "LEFT" : shapes.RIGHT ? "RIGHT" : null;
+  const side = sideCode ? shapes[sideCode] : null;
+  const planes =
+    shapes.FRONT && shapes.BACK ? Math.abs(shapes.FRONT.offsetMm - shapes.BACK.offsetMm) : null;
+
+  let gusset: number | null = null;
+  if (side) {
+    gusset = side.widthMm;
+    if (planes !== null && Math.abs(planes - side.widthMm) > SHAPE_TOLERANCE_MM) {
+      const name = (sideCode && faces[sideCode]?.name) || "print:LEFT";
+      issues.push(
+        modelIssue(
+          "GUSSET_MISMATCH",
+          issueMessages.gussetMismatch(name, side.widthMm, planes),
+          name,
+        ),
+      );
+    }
+  } else if (planes !== null) {
+    gusset = round2(planes);
+  }
+
+  if (!widthFace || gusset === null || gusset <= 0) {
+    issues.push(modelIssue("BAG_MODEL_INCOMPLETE", issueMessages.bagIncomplete()));
+    return { shapes, model: null, issues };
+  }
+
+  return {
+    shapes,
+    model: {
+      kind: "parametric-bag",
+      widthMm: widthFace.widthMm,
+      gussetMm: gusset,
+      heightMm: widthFace.heightMm,
+      topFoldMm: 0,
+      handle: defaults.handle,
+      material: defaults.bagMaterial,
+    },
+    issues,
+  };
+}
diff --git a/src/features/product-design/engine/model3d/measure-cup.ts b/src/features/product-design/engine/model3d/measure-cup.ts
new file mode 100644
index 0000000..644f0fd
--- /dev/null
+++ b/src/features/product-design/engine/model3d/measure-cup.ts
@@ -0,0 +1,170 @@
+import { Vector3 } from "three";
+
+import type { CupModel } from "../template/schema";
+import { issueMessages, type ModelIssue, modelIssue } from "./issues";
+import {
+  type BandShape,
+  CUP_HEIGHT_RANGE_MM,
+  MIN_BODY_EDGES,
+  type ModelDefaults,
+  round2,
+  SHAPE_TOLERANCE_MM,
+} from "./measure-types";
+import { angularIntervals, mostlyInward, widestHoleDeg } from "./measure-winding";
+
+/** Vertices this close in height belong to the same ring (mm). */
+const RING_TOLERANCE_MM = 0.05;
+/** A hole in the circle of triangles narrower than this (degrees) is ignored. */
+const HOLE_TOLERANCE_DEG = 0.5;
+
+type Ring = { radius: number };
+
+function ringOf(points: Vector3[], keep: (p: Vector3) => boolean): Ring {
+  let sum = 0;
+  let count = 0;
+  for (const p of points) {
+    if (!keep(p)) continue;
+    sum += Math.hypot(p.x, p.z);
+    count += 1;
+  }
+  return { radius: count > 0 ? sum / count : 0 };
+}
+
+/** Distinct directions (to 0.1 degree) of the vertices of one ring. */
+function ringDirections(points: Vector3[], keep: (p: Vector3) => boolean): number {
+  const tenths = new Set<number>();
+  for (const p of points) {
+    if (!keep(p) || Math.hypot(p.x, p.z) < 1) continue;
+    const deg = ((Math.atan2(p.x, p.z) * 180) / Math.PI + 360) % 360;
+    tenths.add(Math.round(deg * 10) % 3600);
+  }
+  return tenths.size;
+}
+
+/**
+ * The cup axis is the world Y axis through the origin: every vertex radius is measured from it and
+ * compared with the cone between the top and bottom ring. The ring is closed when the triangles
+ * cover the whole circle around the axis (a hole under 0.5 degrees is ignored); TOO_COARSE takes
+ * the smaller number of distinct directions of the top ring and of the bottom ring. The unit check
+ * uses `modelHeightMm` (the whole model, not the print band).
+ */
+export function measureCup(
+  name: string,
+  points: Vector3[],
+  triangles: ArrayLike<number>,
+  modelHeightMm?: number,
+): { shape: BandShape | null; band: Band | null; issues: ModelIssue[] } {
+  const issues: ModelIssue[] = [];
+  let minY = Infinity;
+  let maxY = -Infinity;
+  for (const p of points) {
+    if (p.y < minY) minY = p.y;
+    if (p.y > maxY) maxY = p.y;
+  }
+  const height = maxY - minY;
+
+  const [minH, maxH] = CUP_HEIGHT_RANGE_MM;
+  const unitsHeight = modelHeightMm ?? height;
+  if (unitsHeight < minH || unitsHeight > maxH) {
+    issues.push(
+      modelIssue("BAD_UNITS", issueMessages.badUnits(name, unitsHeight, CUP_HEIGHT_RANGE_MM), name),
+    );
+  }
+  if (height <= 0) return { shape: null, band: null, issues };
+
+  const top = ringOf(points, (p) => p.y >= maxY - RING_TOLERANCE_MM);
+  const bottom = ringOf(points, (p) => p.y <= minY + RING_TOLERANCE_MM);
+  const radiusAt = (y: number) =>
+    bottom.radius + ((top.radius - bottom.radius) * (y - minY)) / height;
+
+  let deviation = 0;
+  for (const p of points) {
+    deviation = Math.max(deviation, Math.abs(Math.hypot(p.x, p.z) - radiusAt(p.y)));
+  }
+  const holeDeg = widestHoleDeg(angularIntervals(points, triangles), HOLE_TOLERANCE_DEG);
+  const edges = Math.min(
+    ringDirections(points, (p) => p.y >= maxY - RING_TOLERANCE_MM),
+    ringDirections(points, (p) => p.y <= minY + RING_TOLERANCE_MM),
+  );
+  const details: string[] = [];
+  if (deviation > SHAPE_TOLERANCE_MM)
+    details.push(`có điểm lệch ${Math.round(deviation * 10) / 10} mm so với mặt nón`);
+  if (top.radius <= 0 || bottom.radius <= 0) details.push("bán kính vòng bằng 0");
+  if (holeDeg > 0) details.push(`vòng bị hở một đoạn ${Math.round(holeDeg)}°`);
+  if (details.length > 0) {
+    issues.push(
+      modelIssue("NOT_REVOLVED", issueMessages.notRevolved(name, details.join(", ")), name),
+    );
+  }
+  if (edges < MIN_BODY_EDGES) {
+    issues.push(
+      modelIssue("TOO_COARSE", issueMessages.tooCoarse(name, edges, MIN_BODY_EDGES), name),
+    );
+  }
+  if (mostlyInward(points, triangles, (c) => new Vector3(c.x, 0, c.z))) {
+    issues.push(modelIssue("FACES_INWARD", issueMessages.facesInward(name), name));
+  }
+
+  const failed = issues.some((i) => i.level === "error");
+  return {
+    band: failed
+      ? null
+      : {
+          topDiameterMm: top.radius * 2,
+          bottomDiameterMm: bottom.radius * 2,
+          topYMm: maxY,
+          bottomYMm: minY,
+        },
+    shape: failed
+      ? null
+      : {
+          kind: "band",
+          topDiameterMm: round2(top.radius * 2),
+          bottomDiameterMm: round2(bottom.radius * 2),
+          topYMm: round2(maxY),
+          bottomYMm: round2(minY),
+        },
+    issues,
+  };
+}
+
+/** The band's rings before rounding, so extending the cone does not compound rounding. */
+export type Band = {
+  topDiameterMm: number;
+  bottomDiameterMm: number;
+  topYMm: number;
+  bottomYMm: number;
+};
+
+/**
+ * The whole cup from the band: the cone through the band's two rings is extended to Y 0 and to the
+ * highest Y of the model. The offsets invert `y = heightMm * (1 - v / slant)` of viewer3d/cup-mesh.ts
+ * (v = distance along the slant from the rim). Null when the cone closes before the base or the rim.
+ */
+export function cupModelOf(
+  band: Band,
+  modelTopYMm: number,
+  defaults: ModelDefaults,
+): { model: CupModel | null; closes: "base" | "rim" | null } {
+  const height = Math.max(modelTopYMm, band.topYMm);
+  const slope = (band.topDiameterMm - band.bottomDiameterMm) / (band.topYMm - band.bottomYMm);
+  const bottomDiameter = band.bottomDiameterMm - slope * band.bottomYMm;
+  const topDiameter = band.topDiameterMm + slope * (height - band.topYMm);
+  if (bottomDiameter <= 0) return { model: null, closes: "base" };
+  if (topDiameter <= 0) return { model: null, closes: "rim" };
+  const slant = Math.hypot(height, (topDiameter - bottomDiameter) / 2);
+  return {
+    closes: null,
+    model: {
+      kind: "parametric-cup",
+      topDiameterMm: round2(topDiameter),
+      bottomDiameterMm: round2(bottomDiameter),
+      heightMm: round2(height),
+      rimMm: defaults.rimMm,
+      seamMm: defaults.seamMm,
+      bandTopOffsetMm: round2(Math.max(0, slant * (1 - band.topYMm / height))),
+      bandBottomOffsetMm: round2(Math.max(0, (slant * band.bottomYMm) / height)),
+      material: defaults.cupMaterial,
+    },
+  };
+}
diff --git a/src/features/product-design/engine/model3d/measure-points.ts b/src/features/product-design/engine/model3d/measure-points.ts
new file mode 100644
index 0000000..90b0044
--- /dev/null
+++ b/src/features/product-design/engine/model3d/measure-points.ts
@@ -0,0 +1,57 @@
+import { type Mesh, Vector3 } from "three";
+
+/** Triangles of a mesh; 0 for a mesh without a position attribute. */
+export function triangleCount(mesh: Mesh): number {
+  const { geometry } = mesh;
+  const position = geometry.getAttribute("position");
+  if (!position) return 0;
+  return Math.floor((geometry.index ? geometry.index.count : position.count) / 3);
+}
+
+/** Highest world Y among the finite vertices of a mesh; -Infinity when there are none. */
+export function highestWorldY(mesh: Mesh): number {
+  const position = mesh.geometry.getAttribute("position");
+  if (!position) return -Infinity;
+  const v = new Vector3();
+  let highest = -Infinity;
+  for (let i = 0; i < position.count; i++) {
+    v.fromBufferAttribute(position, i).applyMatrix4(mesh.matrixWorld);
+    if (Number.isFinite(v.y) && v.y > highest) highest = v.y;
+  }
+  return highest;
+}
+
+/** Lowest world Y among the finite vertices of a mesh; Infinity when there are none. */
+export function lowestWorldY(mesh: Mesh): number {
+  const position = mesh.geometry.getAttribute("position");
+  if (!position) return Infinity;
+  const v = new Vector3();
+  let lowest = Infinity;
+  for (let i = 0; i < position.count; i++) {
+    v.fromBufferAttribute(position, i).applyMatrix4(mesh.matrixWorld);
+    if (Number.isFinite(v.y) && v.y < lowest) lowest = v.y;
+  }
+  return lowest;
+}
+
+export type PrintPoints = { points: Vector3[]; triangles: number[] } | { problem: string };
+
+/** World-space vertices of a print mesh, or why the mesh cannot be measured. */
+export function printPoints(mesh: Mesh): PrintPoints {
+  const position = mesh.geometry.getAttribute("position");
+  if (!position || position.count === 0) return { problem: "không có đỉnh nào" };
+  if (triangleCount(mesh) === 0) return { problem: "không có tam giác nào" };
+  const points: Vector3[] = [];
+  for (let i = 0; i < position.count; i++) {
+    const p = new Vector3().fromBufferAttribute(position, i).applyMatrix4(mesh.matrixWorld);
+    if (!Number.isFinite(p.x) || !Number.isFinite(p.y) || !Number.isFinite(p.z)) {
+      return { problem: "có toạ độ không hợp lệ (NaN hoặc vô hạn)" };
+    }
+    points.push(p);
+  }
+  const { index } = mesh.geometry;
+  const triangles: number[] = [];
+  const count = index ? index.count : position.count;
+  for (let i = 0; i < count - (count % 3); i++) triangles.push(index ? index.getX(i) : i);
+  return { points, triangles };
+}
diff --git a/src/features/product-design/engine/model3d/measure-types.ts b/src/features/product-design/engine/model3d/measure-types.ts
new file mode 100644
index 0000000..764ee6f
--- /dev/null
+++ b/src/features/product-design/engine/model3d/measure-types.ts
@@ -0,0 +1,53 @@
+import type { BagModel, CupModel } from "../template/schema";
+
+/** What a model cannot tell: the glue seam, the stock and the handle come from the caller. */
+export type ModelDefaults = {
+  seamMm: number;
+  /** only shapes the rim of the number-built fallback model */
+  rimMm: number;
+  cupMaterial: CupModel["material"];
+  bagMaterial: BagModel["material"];
+  handle: BagModel["handle"];
+};
+
+export const DEFAULT_MODEL_DEFAULTS: ModelDefaults = {
+  seamMm: 8,
+  rimMm: 3,
+  cupMaterial: "paper-white",
+  bagMaterial: "kraft-brown",
+  handle: "twisted",
+};
+
+export const CUP_HEIGHT_RANGE_MM = [20, 400] as const;
+export const BAG_HEIGHT_RANGE_MM = [20, 600] as const;
+export const SHAPE_TOLERANCE_MM = 0.5;
+export const MIN_BODY_EDGES = 32;
+export const MAX_TRIANGLES = 100_000;
+export const MAX_FILE_BYTES = 10 * 1024 * 1024;
+
+export const BAG_CODES = ["FRONT", "BACK", "LEFT", "RIGHT"] as const;
+export type BagCode = (typeof BAG_CODES)[number];
+
+/** A cup body measured on its own: the rings of the band, in world millimetres. */
+export type BandShape = {
+  kind: "band";
+  topDiameterMm: number;
+  bottomDiameterMm: number;
+  topYMm: number;
+  bottomYMm: number;
+};
+
+/** A bag face measured on its own; `offsetMm` is its plane on its axis (z for FRONT/BACK, x for LEFT/RIGHT). */
+export type FaceShape = {
+  kind: "face";
+  widthMm: number;
+  heightMm: number;
+  bottomYMm: number;
+  offsetMm: number;
+  /** signed world position of the face's centre along its width axis (x for FRONT/BACK, z for LEFT/RIGHT) */
+  centreMm: number;
+};
+
+export type PrintShape = BandShape | FaceShape;
+
+export const round2 = (n: number) => Math.round(n * 100) / 100;
diff --git a/src/features/product-design/engine/model3d/measure-winding.ts b/src/features/product-design/engine/model3d/measure-winding.ts
new file mode 100644
index 0000000..8b784d1
--- /dev/null
+++ b/src/features/product-design/engine/model3d/measure-winding.ts
@@ -0,0 +1,80 @@
+import type { Vector3 } from "three";
+
+/**
+ * True when most of a surface, by triangle area, has its geometric normal (from the triangle
+ * winding in world space, not the stored normals) pointing against `outwardAt`.
+ */
+export function mostlyInward(
+  points: Vector3[],
+  triangles: ArrayLike<number>,
+  outwardAt: (centroid: Vector3) => Vector3,
+): boolean {
+  let inward = 0;
+  let outward = 0;
+  const e1 = points[0]?.clone();
+  const e2 = points[0]?.clone();
+  const centroid = points[0]?.clone();
+  if (!e1 || !e2 || !centroid) return false;
+  for (let i = 0; i + 2 < triangles.length; i += 3) {
+    const a = points[triangles[i] ?? -1];
+    const b = points[triangles[i + 1] ?? -1];
+    const c = points[triangles[i + 2] ?? -1];
+    if (!a || !b || !c) continue;
+    e1.subVectors(b, a);
+    e2.subVectors(c, a);
+    const normal = e1.cross(e2);
+    centroid
+      .copy(a)
+      .add(b)
+      .add(c)
+      .multiplyScalar(1 / 3);
+    const area = normal.length() / 2;
+    if (normal.dot(outwardAt(centroid)) < 0) inward += area;
+    else outward += area;
+  }
+  return inward > outward;
+}
+
+const TAU_DEG = 360;
+
+/**
+ * The angular intervals (degrees, around the world Y axis) the triangles cover, as seen from the
+ * axis. A triangle that crosses the -Z direction is unwrapped: its interval is the 360 degrees
+ * minus the largest gap between its three directions.
+ */
+export function angularIntervals(
+  points: Vector3[],
+  triangles: ArrayLike<number>,
+): [number, number][] {
+  const intervals: [number, number][] = [];
+  const dir = (p: Vector3) => (Math.atan2(p.x, p.z) * 180) / Math.PI;
+  for (let i = 0; i + 2 < triangles.length; i += 3) {
+    const ps = [triangles[i], triangles[i + 1], triangles[i + 2]].map((k) => points[k ?? -1]);
+    if (ps.some((p) => !p || Math.hypot(p.x, p.z) < 1)) continue;
+    const [s0 = 0, s1 = 0, s2 = 0] = ps.map((p) => (p ? dir(p) : 0)).sort((a, b) => a - b);
+    const gaps = [s1 - s0, s2 - s1, s0 + TAU_DEG - s2];
+    const k = gaps.indexOf(Math.max(...gaps));
+    const start = [s1, s2, s0][k] ?? s0;
+    const extent = TAU_DEG - (gaps[k] ?? 0);
+    const from = ((start % TAU_DEG) + TAU_DEG) % TAU_DEG;
+    if (from + extent > TAU_DEG) {
+      intervals.push([from, TAU_DEG], [0, from + extent - TAU_DEG]);
+    } else {
+      intervals.push([from, from + extent]);
+    }
+  }
+  return intervals;
+}
+
+/** The widest hole (degrees) left by the intervals around the full circle; 0 when covered. */
+export function widestHoleDeg(intervals: [number, number][], toleranceDeg: number): number {
+  const sorted = [...intervals].sort((a, b) => a[0] - b[0]);
+  let cursor = 0;
+  let widest = 0;
+  for (const [from, to] of sorted) {
+    if (from - cursor > toleranceDeg) widest = Math.max(widest, from - cursor);
+    cursor = Math.max(cursor, to);
+  }
+  if (TAU_DEG - cursor > toleranceDeg) widest = Math.max(widest, TAU_DEG - cursor);
+  return widest;
+}
diff --git a/src/features/product-design/engine/model3d/measure.ts b/src/features/product-design/engine/model3d/measure.ts
new file mode 100644
index 0000000..2021310
--- /dev/null
+++ b/src/features/product-design/engine/model3d/measure.ts
@@ -0,0 +1,221 @@
+import { type Object3D, Mesh, type Vector3 } from "three";
+
+import type { BagModel, CupModel, PrintAreaCode } from "../template/schema";
+import { findNearMissNames, findPrintObjects } from "./find-print-meshes";
+import { issueMessages, type ModelIssue, modelIssue } from "./issues";
+import { type FaceInput, measureBag } from "./measure-bag";
+import { cupModelOf, measureCup } from "./measure-cup";
+import { highestWorldY, lowestWorldY, printPoints, triangleCount } from "./measure-points";
+import {
+  BAG_CODES,
+  DEFAULT_MODEL_DEFAULTS,
+  MAX_FILE_BYTES,
+  MAX_TRIANGLES,
+  type ModelDefaults,
+  type PrintShape,
+  SHAPE_TOLERANCE_MM,
+} from "./measure-types";
+
+/**
+ * Recognise, measure and check a model that is already loaded as a three object tree (spec §5).
+ * Pure: no React, no WebGL, no loader. The geometry must already be in millimetres (the loader
+ * scales the file from metres); world transforms are applied here. Never throws.
+ */
+
+export {
+  BAG_HEIGHT_RANGE_MM,
+  type BandShape,
+  CUP_HEIGHT_RANGE_MM,
+  DEFAULT_MODEL_DEFAULTS,
+  type FaceShape,
+  MAX_FILE_BYTES,
+  MAX_TRIANGLES,
+  MIN_BODY_EDGES,
+  type ModelDefaults,
+  type PrintShape,
+  SHAPE_TOLERANCE_MM,
+} from "./measure-types";
+
+export type PrintMeshInfo = {
+  printAreaCode: PrintAreaCode;
+  /** the author's name, e.g. `print:BODY` */
+  meshName: string;
+  /** the mesh itself; null when none could be resolved */
+  mesh: Mesh | null;
+  /** this mesh measured on its own; null when it failed its own checks */
+  shape: PrintShape | null;
+};
+
+export type ModelMeasurement = {
+  kind: "cup" | "bag" | null;
+  /**
+   * For a cup, the WHOLE cup: heightMm is the highest world Y of all meshes (the base is Y 0), the
+   * cone through the band's two rings is extended to Y 0 and to that height for the diameters, and
+   * the band offsets are measured along the slant of the whole cup from rim and base. A body whose
+   * cone closes before the base or the rim is INVALID_GEOMETRY. The band alone is each mesh's `shape`.
+   * Any error-level issue means `model` is null. It can also be null with warnings only
+   * (`BAG_MODEL_INCOMPLETE`: not enough faces to size the whole bag); the per-mesh `shape`s are
+   * still filled in then.
+   */
+  model: CupModel | BagModel | null;
+  printMeshes: PrintMeshInfo[];
+  issues: ModelIssue[];
+};
+
+type Measurable = { entry: PrintMeshInfo; points: Vector3[]; triangles: number[] };
+
+/** Resolve every print object; the first of each code is the one that gets measured. */
+function resolvePrintMeshes(root: Object3D, issues: ModelIssue[]) {
+  const printMeshes: PrintMeshInfo[] = [];
+  const measurable = new Map<PrintAreaCode, Measurable>();
+  const seen = new Set<PrintAreaCode>();
+  const duplicated = new Set<PrintAreaCode>();
+  for (const found of findPrintObjects(root)) {
+    const { printAreaCode, name } = found;
+    const entry: PrintMeshInfo = { printAreaCode, meshName: name, mesh: found.mesh, shape: null };
+    printMeshes.push(entry);
+    if (found.problem === "parent") {
+      // not a print mesh itself: the print objects below it are measured as usual
+      issues.push(modelIssue("INVALID_GEOMETRY", issueMessages.printOnParent(name), name));
+      continue;
+    }
+    if (seen.has(printAreaCode)) {
+      if (!duplicated.has(printAreaCode)) {
+        duplicated.add(printAreaCode);
+        issues.push(
+          modelIssue("DUPLICATE_PRINT_MESH", issueMessages.duplicatePrintMesh(name), name),
+        );
+      }
+      continue;
+    }
+    seen.add(printAreaCode);
+    if (found.problem === "multi") {
+      issues.push(modelIssue("MULTI_MATERIAL_PRINT_MESH", issueMessages.multiMaterial(name), name));
+    } else if (!found.mesh) {
+      issues.push(
+        modelIssue(
+          "INVALID_GEOMETRY",
+          issueMessages.invalidGeometry(name, "không chứa mesh nào"),
+          name,
+        ),
+      );
+    } else {
+      const result = printPoints(found.mesh);
+      if ("problem" in result) {
+        issues.push(
+          modelIssue("INVALID_GEOMETRY", issueMessages.invalidGeometry(name, result.problem), name),
+        );
+      } else {
+        measurable.set(printAreaCode, {
+          entry,
+          points: result.points,
+          triangles: result.triangles,
+        });
+      }
+    }
+  }
+  return { printMeshes, measurable };
+}
+
+export function measureModel(
+  root: Object3D,
+  info: { byteLength?: number } = {},
+  defaults: Partial<ModelDefaults> = {},
+): ModelMeasurement {
+  const settings: ModelDefaults = { ...DEFAULT_MODEL_DEFAULTS, ...defaults };
+  root.updateMatrixWorld(true);
+
+  const issues: ModelIssue[] = [];
+  let triangles = 0;
+  let minY = Infinity;
+  let maxY = -Infinity;
+  root.traverse((object) => {
+    if (!(object instanceof Mesh)) return;
+    triangles += triangleCount(object);
+    minY = Math.min(minY, lowestWorldY(object));
+    maxY = Math.max(maxY, highestWorldY(object));
+  });
+  if (info.byteLength !== undefined && info.byteLength > MAX_FILE_BYTES) {
+    issues.push(
+      modelIssue("FILE_TOO_LARGE", issueMessages.fileTooLarge(info.byteLength, MAX_FILE_BYTES)),
+    );
+  }
+  if (triangles > MAX_TRIANGLES) {
+    issues.push(
+      modelIssue("TOO_MANY_TRIANGLES", issueMessages.tooManyTriangles(triangles, MAX_TRIANGLES)),
+    );
+  }
+
+  const { printMeshes, measurable } = resolvePrintMeshes(root, issues);
+  for (const miss of findNearMissNames(root)) {
+    issues.push(
+      modelIssue(
+        "PRINT_NAME_NEAR_MISS",
+        issueMessages.nameNearMiss(miss.name, miss.expected),
+        miss.name,
+      ),
+    );
+  }
+  const present = new Set(printMeshes.map((m) => m.printAreaCode));
+  const hasBody = present.has("BODY");
+  const hasBag = BAG_CODES.some((code) => present.has(code));
+
+  let kind: ModelMeasurement["kind"] = null;
+  let model: CupModel | BagModel | null = null;
+  if (hasBody && hasBag) {
+    issues.push(modelIssue("MIXED_KINDS", issueMessages.mixedKinds()));
+  } else if (!hasBody && !hasBag) {
+    issues.push(modelIssue("NO_PRINT_MESH", issueMessages.noPrintMesh()));
+  } else if (hasBody) {
+    kind = "cup";
+    const body = measurable.get("BODY");
+    if (body) {
+      const result = measureCup(
+        body.entry.meshName,
+        body.points,
+        body.triangles,
+        Number.isFinite(maxY - minY) ? maxY - minY : undefined,
+      );
+      issues.push(...result.issues);
+      body.entry.shape = result.shape;
+      if (result.band) {
+        const whole = cupModelOf(result.band, maxY, settings);
+        model = whole.model;
+        if (whole.closes) {
+          const name = body.entry.meshName;
+          issues.push(
+            modelIssue("INVALID_GEOMETRY", issueMessages.coneCloses(name, whole.closes), name),
+          );
+        }
+      }
+    }
+  } else {
+    kind = "bag";
+    const faces: Partial<Record<(typeof BAG_CODES)[number], FaceInput>> = {};
+    for (const code of BAG_CODES) {
+      const face = measurable.get(code);
+      if (face)
+        faces[code] = {
+          name: face.entry.meshName,
+          points: face.points,
+          triangles: face.triangles,
+        };
+    }
+    // with no usable face the invalid meshes are already reported
+    if (Object.keys(faces).length > 0) {
+      const result = measureBag(faces, settings);
+      issues.push(...result.issues);
+      for (const code of BAG_CODES) {
+        const face = measurable.get(code);
+        if (face) face.entry.shape = result.shapes[code] ?? null;
+      }
+      model = result.model;
+    }
+  }
+
+  const blocked = issues.some((i) => i.level === "error");
+  if (!blocked && Number.isFinite(minY) && Math.abs(minY) > SHAPE_TOLERANCE_MM) {
+    issues.push(modelIssue("BASE_NOT_AT_ZERO", issueMessages.baseNotAtZero(minY)));
+  }
+  return { kind, model: blocked ? null : model, printMeshes, issues };
+}
diff --git a/src/features/product-design/engine/model3d/print-uv.ts b/src/features/product-design/engine/model3d/print-uv.ts
new file mode 100644
index 0000000..dfcf41e
--- /dev/null
+++ b/src/features/product-design/engine/model3d/print-uv.ts
@@ -0,0 +1,222 @@
+import { BufferGeometry, Float32BufferAttribute, Matrix3, type Mesh, Vector3 } from "three";
+
+import type { BagModel, CupModel } from "../template/schema";
+import { printedWidthMm } from "../viewer3d/cup-mesh";
+import type { PrintTarget } from "../viewer3d/scene-parts";
+
+const TAU = Math.PI * 2;
+
+type Axis = "x" | "z";
+
+/**
+ * For each bag face: the plan axis its width runs along and whether `s` (0 = left seen from
+ * outside) grows with that axis. Mirrors `segmentsOf` in `viewer3d/bag-mesh.ts`: the front runs
+ * towards +X, the right face towards −Z, the back towards −X and the left face towards +Z.
+ */
+const BAG_FACES: Record<string, { axis: Axis; rising: boolean; outward: Vector3 }> = {
+  FRONT: { axis: "x", rising: true, outward: new Vector3(0, 0, 1) },
+  RIGHT: { axis: "z", rising: false, outward: new Vector3(1, 0, 0) },
+  BACK: { axis: "x", rising: false, outward: new Vector3(0, 0, -1) },
+  LEFT: { axis: "z", rising: true, outward: new Vector3(-1, 0, 0) },
+};
+
+/** A triangle corner in world space. */
+type Corner = { p: Vector3; n: Vector3 };
+/** A corner with the cup's axis angle it takes (0 or 2π on the seam cut). */
+type AngledCorner = Corner & { alpha: number };
+
+/** Triangles thinner than this (mm²) left by a cut are dropped. */
+const MIN_AREA_MM2 = 1e-6;
+
+const areaOf = (a: Vector3, b: Vector3, c: Vector3) =>
+  new Vector3().subVectors(b, a).cross(new Vector3().subVectors(c, a)).length() / 2;
+
+/**
+ * Makes a triangle wind outward (swapping two corners when it faces inward) and its normals agree
+ * (negating those that point inward). `outward` is the direction the surface faces at the
+ * triangle; a triangle with no direction or no area is left alone.
+ */
+function faceOutward(
+  tri: [Corner, Corner, Corner],
+  outward: Vector3 | null,
+): [Corner, Corner, Corner] {
+  if (!outward) return tri;
+  const [a, b, c] = tri;
+  const geometric = new Vector3().subVectors(b.p, a.p).cross(new Vector3().subVectors(c.p, a.p));
+  const ordered: [Corner, Corner, Corner] = geometric.dot(outward) < 0 ? [a, c, b] : [a, b, c];
+  const fixed = ordered.map((corner) =>
+    corner.n.dot(outward) < 0 ? { p: corner.p, n: corner.n.clone().negate() } : corner,
+  );
+  return [fixed[0]!, fixed[1]!, fixed[2]!];
+}
+
+/**
+ * The cup triangle as one or two angled triangles. One that crosses the seam half-plane (x = 0,
+ * z < 0, where α is 0 and 2π) is cut there: the part with small α keeps α and its cut corners take
+ * 0, the part with α just below 2π takes 2π on its cut corners, so both map inside the printed
+ * width. A corner exactly on the seam joins the side of its triangle.
+ */
+function splitAtSeam(tri: readonly Corner[]): AngledCorner[][] {
+  const alphas = tri.map((c) => axisAngle(c.p));
+  const max = Math.max(...alphas);
+  const corners = tri.map((c, i): AngledCorner => ({ ...c, alpha: alphas[i]! }));
+  if (max - Math.min(...alphas) <= Math.PI) return [corners];
+
+  const low = alphas.map((alpha) => alpha < max - Math.PI);
+  // Signed distance to the seam plane, never on the wrong side of it for its own region.
+  const side = (i: number) => (low[i] ? Math.min(tri[i]!.p.x, 0) : Math.max(tri[i]!.p.x, 0));
+  const cut = (i: number, j: number, alpha: number): AngledCorner => {
+    const [da, db] = [side(i), side(j)];
+    const t = da === db ? 0 : Math.min(1, Math.max(0, da / (da - db)));
+    const [a, b] = [tri[i]!, tri[j]!];
+    const n = a.n.clone().lerp(b.n, t);
+    return {
+      p: a.p.clone().lerp(b.p, t),
+      n: n.lengthSq() > 0 ? n.normalize() : a.n.clone(),
+      alpha,
+    };
+  };
+
+  return [true, false].flatMap((isLow) => {
+    const polygon: AngledCorner[] = [];
+    for (let i = 0; i < 3; i++) {
+      const j = (i + 1) % 3;
+      if (low[i] === isLow) polygon.push(corners[i]!);
+      if (low[i] !== low[j]) polygon.push(cut(i, j, isLow ? 0 : TAU));
+    }
+    const fan = polygon.slice(1, -1).map((corner, k) => [polygon[0]!, corner, polygon[k + 2]!]);
+    return fan.filter(([a, b, c]) => areaOf(a!.p, b!.p, c!.p) > MIN_AREA_MM2);
+  });
+}
+
+/** `atan2(-x, -z)` in [0, 2π): 0 at −Z (where the cup's seam is), π at +Z, growing towards +X seen from the front. */
+function axisAngle(p: Vector3): number {
+  const alpha = Math.atan2(-p.x, -p.z);
+  return alpha < 0 ? alpha + TAU : alpha;
+}
+
+/**
+ * A print mesh from a loaded model, given the texture coordinates the studio needs: it ignores the
+ * UVs of the file and computes them from each vertex's position with the same formula the
+ * parametric meshes use (`buildCupGeometry` / `buildBagGeometry`), so the artwork lands where the
+ * 2D dieline says.
+ *
+ * The mesh's world transform (`matrixWorld`, parents included) is applied, so the returned
+ * geometry is in world space (mm after the loader's scaling): put it on a mesh with an identity
+ * transform. The cup's axis is the world Y axis through the origin; its front faces +Z. The
+ * result is non-indexed and has `position`, `normal` (the file's, or smooth ones computed when it
+ * has none) and `uv`.
+ *
+ * The result always faces outward (away from the Y axis for a cup; FRONT +Z, BACK −Z, RIGHT +X,
+ * LEFT −X for a bag): a triangle that winds inward, by the file or a mirrored parent, has two
+ * corners swapped, and normals that point inward are negated. A cup triangle that crosses the seam
+ * (x = 0, z < 0) is cut there into two, one ending at α = 0 and one at α = 2π, so no UV leaves
+ * `[0, printed width]` and the whole strip appears on the model. Limit: a triangle spanning more
+ * than π without touching the seam is not understood (a body needs at least a few sides).
+ *
+ * The UV is a function of the vertex's ABSOLUTE world position against the template `model`, never
+ * of the mesh's own extent: a vertex at the same place gets the same UV as on the parametric mesh,
+ * so a mesh shorter or longer than the band is not rescaled, and vertices outside the band map
+ * outside the printed area (no clamping).
+ *
+ * Cup: `α = atan2(−x, −z)`, `v = slant · (1 − y / heightMm)` (the relation `wallAt` in
+ * `cup-mesh.ts` inverts), then `uvOf(toFlat(α/2π · printed width, v))`. Bag: `s` across the face
+ * and `t = (panelHeight − y) / panelHeight`, with the face spans of `segmentsOf` in `bag-mesh.ts`
+ * (FRONT x from −w/2, RIGHT z falling from g/2, BACK x falling from w/2, LEFT z from −g/2), then
+ * `uvOf(toFlat(u0 + (u1 − u0)s, v0 + (v1 − v0)t))`.
+ */
+export function printGeometry(
+  mesh: Mesh,
+  target: PrintTarget,
+  model: CupModel | BagModel,
+): BufferGeometry {
+  const { code, surface } = target;
+  if (model.kind === "parametric-cup" ? code !== "BODY" : !(code in BAG_FACES)) {
+    throw new Error(`Print area ${code} does not exist on a ${model.kind} model`);
+  }
+
+  const source = mesh.geometry;
+  const positionAttr = source.getAttribute("position");
+  if (!positionAttr || positionAttr.itemSize < 3) {
+    throw new Error("The print mesh has no position attribute");
+  }
+
+  // Smooth normals for a file without them, computed in the mesh's own space before de-indexing.
+  const withNormals = source.getAttribute("normal") ? source : source.clone();
+  if (withNormals !== source) withNormals.computeVertexNormals();
+  const normalAttr = withNormals.getAttribute("normal");
+
+  mesh.updateWorldMatrix(true, false);
+  const normalMatrix = new Matrix3().getNormalMatrix(mesh.matrixWorld);
+  const world = Array.from({ length: positionAttr.count }, (_, i) =>
+    new Vector3().fromBufferAttribute(positionAttr, i).applyMatrix4(mesh.matrixWorld),
+  );
+  const worldNormals = Array.from({ length: normalAttr.count }, (_, i) =>
+    new Vector3().fromBufferAttribute(normalAttr, i).applyMatrix3(normalMatrix).normalize(),
+  );
+
+  const index = source.getIndex();
+  const corners = index ? Array.from(index.array) : world.map((_, i) => i);
+  const positions: number[] = [];
+  const normals: number[] = [];
+  const uvs: number[] = [];
+
+  const toUv = (u: number, v: number) => {
+    const flat = surface.toFlat(u, v);
+    return surface.uvOf(flat.x, flat.y);
+  };
+
+  // The UV of a vertex, given the unwrapped axis angle when this is a cup. Always from the
+  // vertex's absolute world position against the model, never from the mesh's own extent.
+  let uvOfVertex: (p: Vector3, alpha: number) => [number, number];
+  if (model.kind === "parametric-cup") {
+    const widthMm = printedWidthMm(model, surface);
+    const slantMm = Math.hypot(model.heightMm, (model.topDiameterMm - model.bottomDiameterMm) / 2);
+    uvOfVertex = (p, alpha) => toUv((alpha / TAU) * widthMm, slantMm * (1 - p.y / model.heightMm));
+  } else {
+    const { axis, rising } = BAG_FACES[code]!;
+    const [u0, u1] = surface.uRange;
+    const [v0, v1] = surface.vRange;
+    const [hw, hg] = [model.widthMm / 2, model.gussetMm / 2];
+    const panelHeight = model.heightMm - model.topFoldMm;
+    // Plan span of the face, as in `segmentsOf`: start and length along its axis.
+    const span =
+      axis === "x" ? { from: -hw, length: model.widthMm } : { from: -hg, length: model.gussetMm };
+    uvOfVertex = (p) => {
+      const along = (p[axis] - span.from) / span.length;
+      const s = rising ? along : 1 - along;
+      const t = (panelHeight - p.y) / panelHeight;
+      return toUv(u0 + (u1 - u0) * s, v0 + (v1 - v0) * t);
+    };
+  }
+
+  const bagOutward = model.kind === "parametric-cup" ? null : BAG_FACES[code]!.outward;
+  for (let k = 0; k + 2 < corners.length; k += 3) {
+    const raw = [corners[k]!, corners[k + 1]!, corners[k + 2]!].map((vertex): Corner => ({
+      p: world[vertex]!,
+      n: worldNormals[vertex]!,
+    }));
+    const [a, b, c] = raw as [Corner, Corner, Corner];
+    // A cup faces away from the Y axis at the triangle's centre; a bag face along its own direction.
+    const centre = new Vector3(a.p.x + b.p.x + c.p.x, 0, a.p.z + b.p.z + c.p.z);
+    const outward = bagOutward ?? (centre.lengthSq() > 1e-9 ? centre : null);
+    const oriented = faceOutward([a, b, c], outward);
+    const pieces: AngledCorner[][] =
+      model.kind === "parametric-cup"
+        ? splitAtSeam(oriented)
+        : [oriented.map((corner) => ({ ...corner, alpha: 0 }))];
+    for (const piece of pieces) {
+      for (const { p, n, alpha } of piece) {
+        positions.push(p.x, p.y, p.z);
+        normals.push(n.x, n.y, n.z);
+        uvs.push(...uvOfVertex(p, alpha));
+      }
+    }
+  }
+
+  const geometry = new BufferGeometry();
+  geometry.setAttribute("position", new Float32BufferAttribute(positions, 3));
+  geometry.setAttribute("normal", new Float32BufferAttribute(normals, 3));
+  geometry.setAttribute("uv", new Float32BufferAttribute(uvs, 2));
+  return geometry;
+}
diff --git a/src/features/product-design/engine/model3d/scene.ts b/src/features/product-design/engine/model3d/scene.ts
new file mode 100644
index 0000000..1f7ba78
--- /dev/null
+++ b/src/features/product-design/engine/model3d/scene.ts
@@ -0,0 +1,208 @@
+import { BackSide, DoubleSide, FrontSide, Group, Mesh, type Material } from "three";
+
+import type { SurfaceSet } from "../surfaces";
+import type { BagModel, CupModel } from "../template/schema";
+import { createMaterials, type ProductMaterials } from "../viewer3d/materials";
+import type { ModelScene, PrintMesh, PrintTarget } from "../viewer3d/scene-parts";
+import { templateDifferences } from "./compare-template";
+import { disposeMaterials, materialsOf, texturesOf } from "./dispose";
+import { BYTE_LENGTH_KEY, Model3dError } from "./load";
+import { measureModel, type PrintMeshInfo, type PrintShape } from "./measure";
+import { NOMINAL_TOLERANCE_MM } from "./issues";
+import { printGeometry } from "./print-uv";
+import type { Model3dRef } from "./schema";
+
+type Model = CupModel | BagModel;
+type Mapped = PrintTarget & { name: string; mesh: Mesh; shape: PrintShape | null };
+
+/** Looks up the mapped mesh in the measurement; the original name is `printMeshes[].meshName`. */
+function resolveMapped(
+  ref: Model3dRef,
+  printMeshes: PrintMeshInfo[],
+  surfaces: SurfaceSet,
+): Mapped[] {
+  return ref.surfaces.map(({ printAreaCode, meshName }) => {
+    const found = printMeshes.find(
+      (m) => m.meshName === meshName && m.printAreaCode === printAreaCode,
+    );
+    if (!found?.mesh) {
+      throw new Model3dError(
+        "MESH_MISSING",
+        `File .glb không có mesh "${meshName}" cho vùng in ${printAreaCode}`,
+      );
+    }
+    const surface = surfaces.byCode[printAreaCode];
+    if (!surface) {
+      throw new Model3dError("INVALID_MODEL", `Mẫu in không có vùng in ${printAreaCode}`);
+    }
+    return {
+      code: printAreaCode,
+      surface,
+      name: meshName,
+      mesh: found.mesh,
+      shape: found.shape,
+    };
+  });
+}
+
+/** Files' own materials get freed with the scene's bundle: the viewer already calls `materials.dispose()`. */
+function withFileMaterials(
+  materials: ProductMaterials,
+  fileMaterials: Set<Material>,
+): ProductMaterials {
+  return {
+    ...materials,
+    dispose() {
+      materials.dispose();
+      disposeMaterials(fileMaterials);
+    },
+  };
+}
+
+/**
+ * Turns a loaded `.glb` (`loadGlb`, in mm) into the scene the viewer shows, the same shape that
+ * `buildModelScene` gives for the parametric model of `model` (the template's).
+ *
+ * Checks, in order: the measurement has no error (`INVALID_MODEL`, with `issues`; warnings alone
+ * do not block, e.g. a bag with one printed face); every print area of the template is mapped and
+ * every mapped mesh exists (`MESH_MISSING`);
+ * every mapped mesh matches the template within 1 mm (`MODEL_MISMATCH`, the differing figures in the
+ * message). Nothing is changed when a check fails.
+ *
+ * Ownership: when this throws, the caller still owns `root` and must free it (`disposeGlbTree`); on
+ * success the scene owns it (`disposeGlbScene`, or `materials.dispose()` plus the geometries).
+ * Children of a mapped print node are kept: they are re-attached to its parent, in place.
+ *
+ * Result: `group` holds the loaded tree as it is (rim, bottom, inner, ... keep the file's materials
+ * and their place) plus one new mesh per mapped print mesh, which carries the geometry of
+ * `printGeometry` (world space, so on an identity transform; the file's own mesh of that name is
+ * taken out and its geometry and material freed). Print meshes start on `materials.base` (a printed
+ * bag face on `onlySide(FrontSide)` with an `-inside` twin, as `buildModelScene` does); the viewer
+ * gives them the print material when the artwork arrives. `meshes` lists every mesh of the group,
+ * the twins included; `printMeshes` only the new ones; `materials` is `createMaterials` for the
+ * template's stock, whose `dispose()` also frees the file's own materials and textures.
+ */
+export function buildGlbScene(
+  root: Group,
+  ref: Model3dRef,
+  model: Model,
+  surfaces: SurfaceSet,
+): ModelScene {
+  const byteLength = root.userData[BYTE_LENGTH_KEY];
+  const measurement = measureModel(
+    root,
+    typeof byteLength === "number" ? { byteLength } : undefined,
+  );
+
+  // The measurement's errors come first: a file that is not a valid model cannot be "missing a mesh".
+  const errors = measurement.issues.filter((issue) => issue.level === "error");
+  if (errors.length > 0) {
+    throw new Model3dError(
+      "INVALID_MODEL",
+      `Model 3D không hợp lệ: ${errors.map((issue) => issue.message).join("; ")}`,
+      measurement.issues,
+    );
+  }
+
+  // Every print area of the template needs its mesh, or its artwork would never show in 3D.
+  const mappedCodes = new Set(ref.surfaces.map((s) => s.printAreaCode));
+  const unmapped = surfaces.order.filter((code) => !mappedCodes.has(code));
+  if (unmapped.length > 0) {
+    throw new Model3dError(
+      "MESH_MISSING",
+      `Model 3D chưa gán mesh cho vùng in: ${unmapped.join(", ")}`,
+    );
+  }
+  const mapped = resolveMapped(ref, measurement.printMeshes, surfaces);
+  if (model.kind === "parametric-cup" && !mapped.some((m) => m.code === "BODY")) {
+    throw new Model3dError("MESH_MISSING", "File .glb chưa gán mesh cho vùng in BODY");
+  }
+
+  const mismatches = mapped.flatMap((m) => templateDifferences(m, model));
+  if (mismatches.length > 0) {
+    throw new Model3dError(
+      "MODEL_MISMATCH",
+      `Model 3D lệch số đo của mẫu quá ${NOMINAL_TOLERANCE_MM} mm: ${mismatches.join("; ")}`,
+    );
+  }
+
+  const geometries = mapped.map((m) => {
+    try {
+      return printGeometry(m.mesh, { code: m.code, surface: m.surface }, model);
+    } catch (error) {
+      throw new Model3dError(
+        "INVALID_MODEL",
+        `Không tính được UV cho ${m.name}: ${error instanceof Error ? error.message : String(error)}`,
+        measurement.issues,
+      );
+    }
+  });
+
+  // ---- nothing can fail from here: swap the print meshes in ---------------------------------
+  const sheet = model.kind === "parametric-bag";
+  const productMaterials = createMaterials(model.material, sheet ? { side: DoubleSide } : {});
+  const removed = mapped.map((m) => m.mesh);
+  // A print node's own children stay in the tree, where they were in the world.
+  for (const mesh of removed) {
+    const parent = mesh.parent;
+    if (parent) [...mesh.children].forEach((child) => parent.attach(child));
+    mesh.removeFromParent();
+  }
+
+  const group = new Group();
+  group.add(root);
+  const printMeshes: PrintMesh[] = [];
+  mapped.forEach(({ code, surface, name }, i) => {
+    const geometry = geometries[i]!;
+    const mesh = new Mesh(
+      geometry,
+      sheet ? productMaterials.onlySide(FrontSide) : productMaterials.base,
+    );
+    mesh.name = name;
+    group.add(mesh);
+    printMeshes.push({ code, surface, mesh });
+    if (sheet) {
+      const inside = new Mesh(geometry, productMaterials.onlySide(BackSide));
+      inside.name = `${name}-inside`;
+      group.add(inside);
+    }
+  });
+
+  // The file's own materials: those a mesh of the file still uses; the removed meshes' are freed.
+  const fileMaterials = new Set<Material>();
+  root.traverse((object) => {
+    if (object instanceof Mesh) materialsOf(object).forEach((m) => fileMaterials.add(m));
+  });
+  const keptTextures = new Set(Array.from(fileMaterials, texturesOf).flat());
+  const unused = new Set<Material>();
+  for (const mesh of removed) {
+    mesh.geometry.dispose();
+    materialsOf(mesh).forEach((m) => fileMaterials.has(m) || unused.add(m));
+  }
+  disposeMaterials(unused, keptTextures);
+
+  const meshes: Mesh[] = [];
+  group.traverse((object) => {
+    if (object instanceof Mesh) meshes.push(object);
+  });
+  return {
+    group,
+    meshes,
+    materials: withFileMaterials(productMaterials, fileMaterials),
+    printMeshes,
+  };
+}
+
+/**
+ * Frees what a scene from `buildGlbScene` owns: every geometry, the print and base materials, the
+ * file's own materials and their textures. The artwork textures belong to the caller.
+ */
+export function disposeGlbScene(scene: ModelScene) {
+  const geometries = new Set<Mesh["geometry"]>();
+  scene.group.traverse((object) => {
+    if (object instanceof Mesh) geometries.add(object.geometry);
+  });
+  geometries.forEach((geometry) => geometry.dispose());
+  scene.materials.dispose();
+  scene.group.removeFromParent();
+}
diff --git a/src/features/product-design/engine/model3d/schema.ts b/src/features/product-design/engine/model3d/schema.ts
new file mode 100644
index 0000000..cd4cb3d
--- /dev/null
+++ b/src/features/product-design/engine/model3d/schema.ts
@@ -0,0 +1,54 @@
+import { z } from "zod";
+
+import { printAreaCodeSchema } from "../template/schema";
+
+/** Longest mesh name the contract takes (spec 2026-11-13 §3). */
+const MESH_NAME_MAX = 100;
+
+/** The mesh the loader looks for: it can only ever find `print:` plus the print area code. */
+export const printMeshName = (code: string) => `print:${code}`;
+
+/**
+ * The `.glb` that stands beside a print configuration's parametric `template.model` (spec
+ * 2026-11-13 §3): where the file is, and which mesh of it carries each print area. The numbers of
+ * the template stay the base of everything 2D; this only feeds the 3D viewer.
+ *
+ * Own rules: each `meshName` is `print:<its printAreaCode>`, no print area twice. The print config
+ * DTO adds the rules that need the template (every print area mapped, none foreign) and, when any
+ * rule fails, drops the link to `null` with a warning instead of failing the config (spec §8: a
+ * problem with the `.glb` never blocks designing).
+ */
+export const model3dRefSchema = z
+  .object({
+    url: z.string().min(1),
+    surfaces: z
+      .array(
+        z.object({
+          printAreaCode: printAreaCodeSchema,
+          meshName: z.string().min(1).max(MESH_NAME_MAX),
+        }),
+      )
+      .min(1),
+  })
+  .superRefine((ref, ctx) => {
+    const seen = new Set<string>();
+    ref.surfaces.forEach((surface, i) => {
+      if (seen.has(surface.printAreaCode)) {
+        ctx.addIssue({
+          code: "custom",
+          path: ["surfaces", i, "printAreaCode"],
+          message: `Print area ${surface.printAreaCode} appears twice`,
+        });
+      }
+      seen.add(surface.printAreaCode);
+      if (surface.meshName !== printMeshName(surface.printAreaCode)) {
+        ctx.addIssue({
+          code: "custom",
+          path: ["surfaces", i, "meshName"],
+          message: `The mesh of print area ${surface.printAreaCode} must be named ${printMeshName(surface.printAreaCode)}`,
+        });
+      }
+    });
+  });
+
+export type Model3dRef = z.infer<typeof model3dRefSchema>;
diff --git a/src/features/product-design/engine/model3d/template-from-model.ts b/src/features/product-design/engine/model3d/template-from-model.ts
