+import { render, screen } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import ModelCheckPage from "../page";
+
+const env = vi.hoisted(() => ({ isMock: false, designMocked: false }));
+
+vi.mock("@/lib/config", () => ({
+  get IS_MOCK() {
+    return env.isMock;
+  },
+  get DESIGN_API_MOCKED() {
+    return env.designMocked;
+  },
+}));
+vi.mock("next/navigation", () => ({
+  notFound: () => {
+    throw new Error("NEXT_NOT_FOUND");
+  },
+}));
+vi.mock("@/features/product-design/components/model-check/model-check-loader", () => ({
+  ModelCheckLoader: () => <p>model-check screen</p>,
+}));
+
+beforeEach(() => {
+  env.isMock = false;
+  env.designMocked = false;
+});
+
+describe("/design/model-check", () => {
+  it("is not found when the design module does not run on the mock", () => {
+    expect(() => ModelCheckPage()).toThrow("NEXT_NOT_FOUND");
+  });
+
+  it.each([
+    ["the design module is mocked", { isMock: false, designMocked: true }],
+    ["the whole app is mocked", { isMock: true, designMocked: false }],
+  ])("opens when %s (the condition of the simulation panel)", (_name, flags) => {
+    Object.assign(env, flags);
+    render(ModelCheckPage());
+    expect(screen.getByText("model-check screen")).toBeVisible();
+  });
+});
