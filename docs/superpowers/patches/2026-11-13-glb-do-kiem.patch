+import type { BagModel, CupModel, ModelIssue, PrintMeshInfo } from "../../engine";
+
+/** What the page keeps of one print part: its name in the file and the size read from it. */
+export type PrintPart = Pick<PrintMeshInfo, "printAreaCode" | "meshName" | "shape">;
+
+/** One `.glb` read and measured; `bytes` stay so the viewer can load the same file. */
+export type MeasuredFile = {
+  fileName: string;
+  bytes: ArrayBuffer;
+  kind: "cup" | "bag" | null;
+  /** The whole cup or bag; null when an error blocks it or a bag cannot be sized. */
+  model: CupModel | BagModel | null;
+  parts: PrintPart[];
+  issues: ModelIssue[];
+};
+
+/** A row of the issue list: the engine's issues, and the page's own (a mismatch with the mould). */
+export type ReportIssue = {
+  code: string;
+  level: "error" | "warning";
+  message: string;
+  meshName?: string;
+};
