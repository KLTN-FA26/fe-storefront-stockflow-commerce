+++ b/src/features/product-design/components/model-check/model-check-dieline.tsx
@@ -0,0 +1,53 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+import type { PrintArea, PrintSurface } from "../../engine";
+import { readGridColors } from "./grid-colors";
+import { drawGridTexture, gridPxPerMm } from "./grid-texture";
+import { formatMm } from "./model-check-messages";
+
+/** The flat sheet on screen is drawn smaller than the 3D texture: it only has to be read. */
+const SCREEN_SHARE = 0.5;
+
+/**
+ * One print area's flat sheet with the same numbered grid as on the model, so a number on the
+ * model can be found on the sheet. The caption gives the print's size.
+ */
+export function ModelCheckDieline({
+  area,
+  surface,
+  seamAtMm,
+}: {
+  area: PrintArea;
+  surface: PrintSurface;
+  seamAtMm: number | null;
+}) {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (canvas === null) return;
+    drawGridTexture(canvas, surface, {
+      pxPerMm: gridPxPerMm(surface.flatBounds) * SCREEN_SHARE,
+      colors: readGridColors(),
+      seamAtMm,
+    });
+  }, [surface, seamAtMm]);
+
+  const { width, height } = surface.flatBounds;
+  return (
+    <figure className="bg-bg-surface border-border-default space-y-2 rounded-[var(--r-lg)] border p-[var(--card-pad)] shadow-[var(--sh-sm)]">
+      <canvas
+        ref={canvasRef}
+        role="img"
+        aria-label={`Khuôn phẳng của ${area.name}, có lưới đánh số`}
+        className="border-border-default mx-auto block h-auto max-h-80 w-auto max-w-full rounded-[var(--r-sm)] border"
+        style={{ aspectRatio: `${width} / ${height}` }}
+      />
+      <figcaption className="text-ink-secondary text-center text-xs tabular-nums">
+        {`${area.name}: phần in ${formatMm(area.widthMm)} × ${formatMm(area.heightMm)}, tràn lề ${formatMm(area.bleedMm)}, lề an toàn ${formatMm(area.safeMarginMm)}`}
+      </figcaption>
+    </figure>
+  );
+}
