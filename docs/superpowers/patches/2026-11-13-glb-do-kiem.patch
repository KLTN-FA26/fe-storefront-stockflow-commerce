+"use client";
+
+import dynamic from "next/dynamic";
+
+// The tool reads files and runs three.js: browser only, and loaded by this route alone.
+const ModelCheckScreen = dynamic(
+  () => import("./model-check-screen").then((mod) => mod.ModelCheckScreen),
+  {
+    ssr: false,
+    loading: () => (
+      <p role="status" className="text-ink-secondary p-6 text-sm">
+        Đang tải trang thử model…
+      </p>
+    ),
+  },
+);
+
+/** `ssr: false` is only allowed in a client component, so the page renders the screen through this. */
+export function ModelCheckLoader() {
+  return <ModelCheckScreen />;
+}
