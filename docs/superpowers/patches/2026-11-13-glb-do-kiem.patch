+"use client";
+
+import { useEffect, useRef, useState } from "react";
+
+import { Alert } from "@/components/shared/Alert";
+import { Button } from "@/components/ui/button";
+
+import {
+  isWebGLAvailable,
+  ProductViewer,
+  type loadGlb,
+  type Model3dErrorCode,
+  type PrintAreaCode,
+} from "../../engine";
+import { readGridColors } from "./grid-colors";
+import { drawGridTexture, gridPxPerMm } from "./grid-texture";
+import { PART_NAME, VIEWER_FAILURE } from "./model-check-messages";
+import type { MeasuredFile } from "./model-check-types";
+import type { Mould } from "./model-mould";
+
+/** Where the file stands in the viewer; `failed` carries the viewer's own code. */
+type ViewState =
+  | { status: "loading" }
+  | { status: "ready" }
+  | { status: "failed"; code: Model3dErrorCode }
+  | { status: "unavailable" };
+
+/**
+ * The model of the file as the studio will show it: the real viewer, the numbered grid as each
+ * print area's texture. When the viewer cannot show the file the 3D view is hidden and its code
+ * explained, since the number-built stand-in would pass for the person's model.
+ */
+export function ModelCheckViewer({
+  file,
+  mould,
+  loadModel,
+}: {
+  file: MeasuredFile;
+  mould: Extract<Mould, { ok: true }>;
+  loadModel: typeof loadGlb;
+}) {
+  const { template, surfaces, seamAtMm } = mould;
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const viewerRef = useRef<ProductViewer | null>(null);
+  const [view, setView] = useState<ViewState>(() =>
+    isWebGLAvailable() ? { status: "loading" } : { status: "unavailable" },
+  );
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (canvas === null || !isWebGLAvailable()) return;
+    let viewer: ProductViewer;
+    try {
+      // Each load gets its own copy of the bytes: the viewer's scene owns what it loads.
+      viewer = new ProductViewer(canvas, {
+        loadModel3d: (_source, opts) => loadModel(file.bytes.slice(0), opts),
+      });
+    } catch {
+      queueMicrotask(() => setView({ status: "unavailable" }));
+      return;
+    }
+    viewerRef.current = viewer;
+    const offState = viewer.on("model3d", (state) => {
+      if (state.status === "failed")
+        setView({ status: "failed", code: state.code ?? "LOAD_FAILED" });
+      else setView({ status: state.status });
+    });
+    const offLost = viewer.on("contextlost", () => setView({ status: "unavailable" }));
+    const offError = viewer.on("error", () => setView({ status: "unavailable" }));
+
+    const colors = readGridColors();
+    for (const code of surfaces.order) {
+      const surface = surfaces.byCode[code];
+      if (surface === undefined) continue;
+      const texture = document.createElement("canvas");
+      drawGridTexture(texture, surface, {
+        pxPerMm: gridPxPerMm(surface.flatBounds),
+        colors,
+        seamAtMm,
+      });
+      viewer.setSurfaceTexture(code, texture);
+    }
+    try {
+      viewer.setModel(template, surfaces, {
+        url: file.fileName,
+        surfaces: file.parts.map(({ printAreaCode, meshName }) => ({ printAreaCode, meshName })),
+      });
+    } catch {
+      queueMicrotask(() => setView({ status: "unavailable" }));
+    }
+    return () => {
+      offState();
+      offLost();
+      offError();
+      viewerRef.current = null;
+      viewer.dispose();
+    };
+  }, [file, template, surfaces, seamAtMm, loadModel]);
+
+  const turnTo = (code: PrintAreaCode) => viewerRef.current?.focusSurface(code);
+
+  return (
+    <section aria-labelledby="model-check-3d" className="space-y-3">
+      <h2 id="model-check-3d" className="font-display text-ink-primary text-lg font-semibold">
+        Model 3D với lưới đánh số
+      </h2>
+      <div className="bg-bg-surface border-border-default relative h-112 overflow-hidden rounded-[var(--r-lg)] border shadow-[var(--sh-sm)]">
+        <canvas
+          ref={canvasRef}
+          role="img"
+          aria-label="Model 3D của file, có lưới đánh số: kéo để xoay"
+          className={`absolute inset-0 block size-full touch-none ${view.status === "ready" ? "" : "invisible"}`}
+        />
+        {view.status === "loading" && (
+          <p
+            role="status"
+            className="text-ink-secondary absolute inset-0 grid place-items-center text-sm"
+          >
+            Đang dựng model 3D từ file…
+          </p>
+        )}
+        {view.status === "failed" && (
+          <div className="absolute inset-0 grid place-items-center p-4">
+            <div role="alert">
+              <Alert tone="danger" title="Không hiện được model từ file của bạn.">
+                {`Mã lỗi ${view.code}: ${VIEWER_FAILURE[view.code]} Mẫu thay thế do hệ thống dựng đã được ẩn để không bị nhầm với file của bạn.`}
+              </Alert>
+            </div>
+          </div>
+        )}
+        {view.status === "unavailable" && (
+          <div className="absolute inset-0 grid place-items-center p-4">
+            <div role="alert">
+              <Alert tone="warning" title="Trình duyệt này không hiện được 3D.">
+                Bạn vẫn xem được số đo, lỗi và khuôn phẳng ở trang này.
+              </Alert>
+            </div>
+          </div>
+        )}
+      </div>
+      <div className="flex flex-wrap gap-2" role="group" aria-label="Xoay model tới từng phần in">
+        {surfaces.order.map((code) => (
+          <Button
+            key={code}
+            type="button"
+            variant="outline"
+            disabled={view.status !== "ready"}
+            className="min-h-11 rounded-[var(--r-md)] px-4"
+            onClick={() => turnTo(code)}
+          >
+            {`Xoay tới ${PART_NAME[code].toLowerCase()}`}
+          </Button>
+        ))}
+      </div>
+    </section>
+  );
+}
