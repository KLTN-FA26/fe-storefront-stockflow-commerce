+describe("tolerance at exactly 1 mm", () => {
+  // A straight cup whose band figures are round numbers, so +1.0 is exact in the file.
+  const model: CupModel = {
+    kind: "parametric-cup",
+    topDiameterMm: 80,
+    bottomDiameterMm: 80,
+    heightMm: 100,
+    rimMm: 3,
+    seamMm: 5,
+    bandTopOffsetMm: 10,
+    bandBottomOffsetMm: 10,
+    material: "paper-white",
+  };
+  const surfaces = createSurfaces({ ...cup12oz, model });
+
+  function band(f: { topY: number; bottomY: number; topR: number; bottomR: number }): Group {
+    const segments = 64;
+    const positions: number[] = [];
+    for (const [y, r] of [
+      [f.topY, f.topR],
+      [f.bottomY, f.bottomR],
+    ] as const) {
+      for (let i = 0; i < segments; i++) {
+        const a = (i / segments) * Math.PI * 2;
+        positions.push(-r * Math.sin(a), y, -r * Math.cos(a));
+      }
+    }
+    const index: number[] = [];
+    for (let i = 0; i < segments; i++) {
+      const j = (i + 1) % segments;
+      index.push(i, j, i + segments, j, j + segments, i + segments);
+    }
+    const g = new BufferGeometry();
+    g.setAttribute("position", new BufferAttribute(new Float32Array(positions), 3));
+    g.setIndex(index);
+    const root = new Group();
+    root.add(namedMesh("print:BODY", g));
+    return root;
+  }
+  const exact = { topY: 90, bottomY: 10, topR: 40, bottomR: 40 };
+
+  it("accepts the exact figures", () => {
+    expect(() => buildGlbScene(band(exact), bodyRef, model, surfaces)).not.toThrow();
+  });
+
+  it.each([
+    ["band top Y", { topY: 91 }, { topY: 91.1 }, "Y đỉnh thân in"],
+    ["band bottom Y", { bottomY: 11 }, { bottomY: 11.1 }, "Y đáy thân in"],
+    ["top diameter", { topR: 40.5 }, { topR: 40.55 }, "đường kính đỉnh thân in"],
+    ["bottom diameter", { bottomR: 40.5 }, { bottomR: 40.55 }, "đường kính đáy thân in"],
+  ])("%s: 1.0 mm off passes, 1.1 mm off fails", (_label, pass, fail, text) => {
+    expect(() =>
+      buildGlbScene(band({ ...exact, ...pass }), bodyRef, model, surfaces),
+    ).not.toThrow();
+    const error = expectCode(
+      () => buildGlbScene(band({ ...exact, ...fail }), bodyRef, model, surfaces),
+      "MODEL_MISMATCH",
+    );
+    expect(error.message).toContain(text);
+  });
+});
+
+describe("buildGlbScene keeps the tree intact when it throws", () => {
+  it("leaves root exactly as it was when printGeometry throws", async () => {
+    const root = await loadGlb(sampleBytes());
+    const children = [...root.children];
+    const meshes: [Mesh, unknown, unknown][] = [];
+    root.traverse((o) => {
+      if (o instanceof Mesh) meshes.push([o, o.geometry, o.material]);
+    });
+    const dispose = vi.spyOn(BufferGeometry.prototype, "dispose");
+    const materialDispose = vi.spyOn(MeshStandardMaterial.prototype, "dispose");
+    vi.mocked(printGeometry).mockImplementationOnce(() => {
+      throw new Error("boom");
+    });
+
+    const error = expectCode(
+      () => buildGlbScene(root, bodyRef, cupModel, cupSurfaces),
+      "INVALID_MODEL",
+    );
+    expect(error.message).toContain("boom");
+    expect(root.children).toEqual(children);
+    expect(root.parent).toBeNull();
+    for (const [mesh, geometry, material] of meshes) {
+      expect(mesh.geometry).toBe(geometry);
+      expect(mesh.material).toBe(material);
+    }
+    expect(dispose).not.toHaveBeenCalled();
+    expect(materialDispose).not.toHaveBeenCalled();
+    dispose.mockRestore();
+    materialDispose.mockRestore();
+  });
+});
+
+describe("a print node with children", () => {
+  it("keeps the children in the tree, in place, instead of dropping them", () => {
+    const root = new Group();
