+import {
+  createSurfaces,
+  printedWidthMm,
+  templateDifferences,
+  templateFromModel,
+  type CustomizationTemplate,
+  type SurfaceSet,
+} from "../../engine";
+import { mismatchMessage } from "./model-check-messages";
+import type { MeasuredFile, ReportIssue } from "./model-check-types";
+
+/** The flat mould worked out from a measured model, and how the file's parts differ from it. */
+export type Mould =
+  | {
+      ok: true;
+      template: CustomizationTemplate;
+      surfaces: SurfaceSet;
+      /** Where a cup's glue flap starts along its print; null for a bag. */
+      seamAtMm: number | null;
+      /** The comparison the viewer makes, run here so the page can say where a part is off. */
+      differences: ReportIssue[];
+    }
+  | { ok: false };
+
+/** Template and surfaces for a model that can be shown; null when there is no model to build from. */
+export function mouldOf(file: MeasuredFile): Mould | null {
+  const { model } = file;
+  if (model === null) return null;
+  try {
+    const template = templateFromModel(model, file.parts);
+    const surfaces = createSurfaces(template);
+    const body = surfaces.byCode.BODY;
+    const seamAtMm = model.kind === "parametric-cup" && body ? printedWidthMm(model, body) : null;
+    const kind = model.kind === "parametric-cup" ? "cup" : "bag";
+    const differences = file.parts.flatMap((part) => {
+      const surface = surfaces.byCode[part.printAreaCode];
+      if (surface === undefined) return [];
+      const found = templateDifferences(
+        { code: part.printAreaCode, surface, shape: part.shape },
+        model,
+      );
+      return found.map((difference): ReportIssue => ({
+        code: "MODEL_MISMATCH",
+        level: "error",
+        message: mismatchMessage(kind, difference),
+        meshName: part.meshName,
+      }));
+    });
+    return { ok: true, template, surfaces, seamAtMm, differences };
+  } catch {
+    return { ok: false };
+  }
+}
diff --git a/src/features/product-design/components/model-check/use-model-check.ts b/src/features/product-design/components/model-check/use-model-check.ts
new file mode 100644
index 0000000..dacfddd
--- /dev/null
+++ b/src/features/product-design/components/model-check/use-model-check.ts
@@ -0,0 +1,85 @@
+"use client";
+
+import { useRef, useState } from "react";
+
+import { disposeGlbTree, loadGlb, measureModel, Model3dError } from "../../engine";
+import {
+  READ_LIMIT_BYTES,
+  SLOW_FILE,
+  tooBigToRead,
+  UNREADABLE_CAUSES,
+  UNREADABLE_FILE,
+} from "./model-check-messages";
+import type { MeasuredFile } from "./model-check-types";
+
+export type Phase =
+  | { status: "idle" }
+  | { status: "reading"; fileName: string }
+  | { status: "unreadable"; fileName: string; reason: string }
+  | { status: "done"; key: number; file: MeasuredFile };
+
+/** The file's bytes in this window's own `ArrayBuffer` (the loader tells bytes from text by it). */
+export async function readBytes(file: File): Promise<ArrayBuffer> {
+  const read = await new Promise<ArrayBuffer>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result as ArrayBuffer);
+    reader.onerror = () => reject(reader.error);
+    reader.readAsArrayBuffer(file);
+  });
+  const bytes = new ArrayBuffer(read.byteLength);
+  new Uint8Array(bytes).set(new Uint8Array(read));
+  return bytes;
+}
+
+/** Why a file could not be read: the loader's own words for a slow file, the likely causes otherwise. */
+function reasonOf(error: unknown): string {
+  if (error instanceof Model3dError && error.reason === "timeout") return SLOW_FILE;
+  const detail = error instanceof Error && error.message ? ` Chi tiết: ${error.message}` : "";
+  return `${UNREADABLE_FILE} ${UNREADABLE_CAUSES}${detail}`;
+}
+
+/**
+ * Reading and measuring one `.glb` at a time: the drop box is shut while a file is read, so a
+ * second read never starts before the first ends. `loadModel` is the loader (replaceable in tests).
+ */
+export function useModelCheck(loadModel: typeof loadGlb = loadGlb) {
+  const [phase, setPhase] = useState<Phase>({ status: "idle" });
+  const files = useRef(0);
+
+  async function choose(file: File) {
+    if (file.size > READ_LIMIT_BYTES) {
+      setPhase({ status: "unreadable", fileName: file.name, reason: tooBigToRead(file.size) });
+      return;
+    }
+    setPhase({ status: "reading", fileName: file.name });
+    try {
+      const bytes = await readBytes(file);
+      const root = await loadModel(bytes.slice(0));
+      try {
+        const measured = measureModel(root, { byteLength: bytes.byteLength });
+        setPhase({
+          status: "done",
+          key: ++files.current,
+          file: {
+            fileName: file.name,
+            bytes,
+            kind: measured.kind,
+            model: measured.model,
+            parts: measured.printMeshes.map(({ printAreaCode, meshName, shape }) => ({
+              printAreaCode,
+              meshName,
+              shape,
+            })),
+            issues: measured.issues,
+          },
+        });
+      } finally {
+        disposeGlbTree(root);
+      }
+    } catch (error) {
+      setPhase({ status: "unreadable", fileName: file.name, reason: reasonOf(error) });
+    }
+  }
+
+  return { phase, choose };
+}
diff --git a/src/features/product-design/engine/__tests__/model3d-measure.test.ts b/src/features/product-design/engine/__tests__/model3d-measure.test.ts
new file mode 100644
index 0000000..bd11a0c
--- /dev/null
+++ b/src/features/product-design/engine/__tests__/model3d-measure.test.ts
@@ -0,0 +1,1008 @@
+// @vitest-environment node
+import { readFileSync } from "node:fs";
+import path from "node:path";
+
+import { BufferAttribute, BufferGeometry, Group, Mesh, type Object3D } from "three";
+import { describe, expect, it } from "vitest";
+
+import { compareWithNominal } from "../model3d/issues";
+import { loadGlb } from "../model3d/load";
+import {
+  DEFAULT_MODEL_DEFAULTS,
+  MAX_FILE_BYTES,
+  MAX_TRIANGLES,
+  measureModel,
+} from "../model3d/measure";
+import { bagModelSchema, cupModelSchema } from "../template/schema";
+
+type Vec = [number, number, number];
+
+type ConeOptions = {
+  topR: number;
+  bottomR: number;
+  height: number;
+  segments?: number;
+  y0?: number;
+  rings?: number;
+  bulge?: number;
+  /** angular sweep of the band; below 360 the ring is open */
+  sweepDeg?: number;
+  /** one extra vertex at the seam, as Blender exports at a UV seam */
+  seamDuplicate?: boolean;
+  /** centre of the rings in x */
+  shiftX?: number;
+  /** angular offset (radians) of each ring, top-down, as in a triangulated or CAD mesh */
+  ringOffsets?: number[];
+  /** leave out the quad of this segment index */
+  skipQuad?: number;
+  /** wind the triangles inward */
+  inward?: boolean;
+};
+
+/** A band of a truncated cone around Y, rings top-down. */
+function coneBand(o: ConeOptions): BufferGeometry {
+  const segments = o.segments ?? 64;
+  const rings = o.rings ?? 2;
+  const y0 = o.y0 ?? 0;
+  const sweep = ((o.sweepDeg ?? 360) * Math.PI) / 180;
+  const open = (o.sweepDeg ?? 360) < 360;
+  const perRing = open || o.seamDuplicate ? segments + 1 : segments;
+  const positions: number[] = [];
+  const index: number[] = [];
+  for (let j = 0; j < rings; j++) {
+    const t = j / (rings - 1);
+    const y = y0 + o.height * (1 - t);
+    const r = o.topR + (o.bottomR - o.topR) * t;
+    for (let i = 0; i < perRing; i++) {
+      const a = (i / segments) * sweep + (o.ringOffsets?.[j] ?? 0);
+      // `bulge` pushes one vertex of the middle ring outwards
+      const extra = o.bulge && j > 0 && j < rings - 1 && i === 0 ? o.bulge : 0;
+      positions.push(-(r + extra) * Math.sin(a) + (o.shiftX ?? 0), y, -(r + extra) * Math.cos(a));
+    }
+  }
+  const wraps = perRing === segments;
+  for (let j = 0; j < rings - 1; j++) {
+    for (let i = 0; i < (wraps ? perRing : perRing - 1); i++) {
+      const a = j * perRing + i;
+      const b = j * perRing + ((i + 1) % perRing);
+      if (j === 0 && i === o.skipQuad) continue;
+      // outward winding: the geometric normal points away from the axis
+      if (o.inward) index.push(a, b, a + perRing, b, b + perRing, a + perRing);
+      else index.push(a, a + perRing, b, b, a + perRing, b + perRing);
+    }
+  }
+  const g = new BufferGeometry();
+  g.setAttribute("position", new BufferAttribute(new Float32Array(positions), 3));
+  g.setIndex(index);
+  return g;
+}
+
+function quad(corners: [Vec, Vec, Vec, Vec]): BufferGeometry {
+  const g = new BufferGeometry();
+  g.setAttribute("position", new BufferAttribute(new Float32Array(corners.flat()), 3));
+  g.setIndex([0, 1, 2, 0, 2, 3]);
+  return g;
+}
+
+function named(name: string, geometry: BufferGeometry): Mesh {
+  const mesh = new Mesh(geometry);
+  mesh.name = name;
+  return mesh;
+}
+
+function rootOf(...meshes: Object3D[]): Group {
+  const root = new Group();
+  root.add(...meshes);
+  return root;
+}
+
+/** measureModel, plus: every model it returns satisfies the zod model schema. */
+function measure(...args: Parameters<typeof measureModel>) {
+  const r = measureModel(...args);
+  if (r.model) {
+    const schema = r.model.kind === "parametric-cup" ? cupModelSchema : bagModelSchema;
+    expect(schema.safeParse(r.model).success).toBe(true);
+  }
+  return r;
+}
+
+const defaultCone: ConeOptions = { topR: 45, bottomR: 30, height: 80 };
+const cupBody = (o: ConeOptions = defaultCone) => named("print:BODY", coneBand(o));
+const cupOf = (o: Partial<ConeOptions> = {}) => measure(rootOf(cupBody({ ...defaultCone, ...o })));
+
+type FaceSpec = { w: number; g: number; h: number };
+type BagCode = "FRONT" | "BACK" | "LEFT" | "RIGHT";
+/** Four bag faces: FRONT at +z, BACK at -z, LEFT at -x, RIGHT at +x. */
+function bagFaces({ w, g, h }: FaceSpec): Record<BagCode, Mesh> {
+  return {
+    FRONT: named(
+      "print:FRONT",
+      quad([
+        [-w / 2, h, g / 2],
+        [-w / 2, 0, g / 2],
+        [w / 2, 0, g / 2],
+        [w / 2, h, g / 2],
+      ]),
+    ),
+    BACK: named(
+      "print:BACK",
+      quad([
+        [w / 2, h, -g / 2],
+        [w / 2, 0, -g / 2],
+        [-w / 2, 0, -g / 2],
+        [-w / 2, h, -g / 2],
+      ]),
+    ),
+    LEFT: named(
+      "print:LEFT",
+      quad([
+        [-w / 2, h, -g / 2],
+        [-w / 2, 0, -g / 2],
+        [-w / 2, 0, g / 2],
+        [-w / 2, h, g / 2],
+      ]),
+    ),
+    RIGHT: named(
+      "print:RIGHT",
+      quad([
+        [w / 2, h, g / 2],
+        [w / 2, 0, g / 2],
+        [w / 2, 0, -g / 2],
+        [w / 2, h, -g / 2],
+      ]),
+    ),
+  };
+}
+
+const allBag = (spec: FaceSpec = { w: 120, g: 80, h: 160 }) => Object.values(bagFaces(spec));
+const codes = (r: ReturnType<typeof measureModel>) => r.issues.map((i) => i.code);
+
+/** A mesh with `triangles` triangles that is not a print mesh. */
+function decor(triangles: number): Mesh {
+  const g = new BufferGeometry();
+  g.setAttribute("position", new BufferAttribute(new Float32Array(9), 3));
+  g.setIndex(new Array<number>(triangles * 3).fill(0));
+  return named("decor", g);
+}
+
+/** A cone of the 90 / 60 / 110 cup: radius at height y (the sample cup). */
