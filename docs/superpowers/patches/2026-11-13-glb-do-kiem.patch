@@ -0,0 +1,172 @@
+"use client";
+
+import Link from "next/link";
+import { useMemo, useState } from "react";
+
+import { Alert } from "@/components/shared/Alert";
+import { EmptyState } from "@/components/shared/EmptyState";
+import { STORE_ROUTES } from "@/constants";
+
+import { compareWithNominal, loadGlb } from "../../engine";
+import { defaultFigures } from "./config-snippet";
+import {
+  ModelCheckDropzone,
+  NominalInputs,
+  parseNominal,
+  type NominalKey,
+} from "./model-check-controls";
+import { ModelCheckDieline } from "./model-check-dieline";
+import { ModelCheckJson } from "./model-check-json";
+import { FILE_CHECKLIST, LEGEND } from "./model-check-messages";
+import { ModelCheckReport } from "./model-check-report";
+import { ModelCheckViewer } from "./model-check-viewer";
+import { mouldOf } from "./model-mould";
+import { useModelCheck } from "./use-model-check";
+
+/**
+ * The model-check page (spec 2026-11-13 §6): a `.glb` from Blender is read on this computer and
+ * the page says whether it is usable, what sizes were read, and how a numbered grid lands on each
+ * print area. `loadModel` is the loader, replaceable for tests.
+ */
+export function ModelCheckScreen({ loadModel = loadGlb }: { loadModel?: typeof loadGlb }) {
+  const { phase, choose } = useModelCheck(loadModel);
+  const [typed, setTyped] = useState<Partial<Record<NominalKey, string>>>({});
+
+  const onFile = (next: File) => {
+    setTyped({});
+    void choose(next);
+  };
+
+  const file = phase.status === "done" ? phase.file : null;
+  const { nominal, invalid } = useMemo(() => parseNominal(typed), [typed]);
+  const nominalIssues = useMemo(
+    () => (file?.model ? compareWithNominal(file.model, nominal) : []),
+    [file, nominal],
+  );
+  const mould = useMemo(() => (file ? mouldOf(file) : null), [file]);
+  const differences = mould?.ok === true ? mould.differences : [];
+  const shown = mould?.ok === true && differences.length === 0 ? mould : null;
+
+  return (
+    <main className="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-6 p-6">
+      <header className="space-y-1">
+        <h1 className="font-display text-ink-primary text-2xl font-semibold">Thử model 3D</h1>
+        <p className="text-ink-secondary text-sm">
+          Chọn file .glb vừa xuất từ Blender để xem file dùng được chưa, đọc ra những số đo nào và
+          lưới đánh số nằm ra sao trên từng phần in. Trang này chỉ có khi chạy dữ liệu mẫu.{" "}
+          <Link
+            href={STORE_ROUTES.design.list}
+            className="text-accent underline-offset-2 hover:underline"
+          >
+            Về thiết kế của tôi
+          </Link>
+        </p>
+      </header>
+
+      <div className="grid gap-4 lg:grid-cols-2">
+        <ModelCheckDropzone busy={phase.status === "reading"} onFile={onFile} />
+        <div className="bg-bg-surface border-border-default rounded-[var(--r-lg)] border p-[var(--card-pad)] shadow-[var(--sh-sm)]">
+          <h2 className="text-ink-primary text-sm font-semibold">File cần theo quy ước</h2>
+          <ul className="text-ink-secondary mt-2 list-disc space-y-1 pl-5 text-sm">
+            {FILE_CHECKLIST.map((rule) => (
+              <li key={rule}>{rule}</li>
+            ))}
+          </ul>
+        </div>
+      </div>
+
+      {phase.status === "idle" && (
+        <EmptyState
+          title="Chưa chọn file"
+          description="Kéo thả hoặc chọn một file .glb ở trên. Kết quả sẽ hiện ở đây."
+        />
+      )}
+      {phase.status === "reading" && (
+        <p role="status" className="text-ink-secondary text-sm">
+          {`Đang đọc ${phase.fileName}…`}
+        </p>
+      )}
+      {phase.status === "unreadable" && (
+        <div role="alert">
+          <Alert tone="danger" title={`Không đọc được ${phase.fileName}.`}>
+            {phase.reason}
+          </Alert>
+        </div>
+      )}
+
+      {file !== null && (
+        <>
+          <p className="text-ink-secondary text-sm">
+            Đã đọc <span className="text-ink-primary font-mono">{file.fileName}</span>
+          </p>
+          <ModelCheckReport
+            file={file}
+            extraIssues={[...differences, ...nominalIssues]}
+            defaults={mould?.ok === true ? defaultFigures(file, mould) : null}
+          />
+          {file.kind !== null && file.model !== null && (
+            <NominalInputs
+              kind={file.kind}
+              values={typed}
+              invalid={invalid}
+              onChange={(key, text) => setTyped((now) => ({ ...now, [key]: text }))}
+            />
+          )}
+          {file.model === null && (
+            <Alert tone="info" title="Chưa hiện model 3D, khuôn phẳng và cấu hình.">
+              {file.issues.some((issue) => issue.level === "error")
+                ? "File còn lỗi ở trên. Sửa trong Blender, xuất lại rồi chọn file lần nữa."
+                : "Chưa đủ mặt để đo cả túi, nên bản này chưa dựng model 3D và chưa tạo đoạn cấu hình. Số đo từng mặt có trong bảng trên."}
+            </Alert>
+          )}
+          {differences.length > 0 && (
+            <Alert tone="info" title="Chưa hiện model 3D, khuôn phẳng và cấu hình.">
+              Phần in lệch khuôn tính ra từ chính file: sửa theo các lỗi ở trên, xuất lại rồi chọn
+              file lần nữa.
+            </Alert>
+          )}
+          {mould?.ok === false && (
+            <Alert tone="danger" title="Không dựng được khuôn phẳng từ số đo này.">
+              Kiểm tra lại các phần in trong file.
+            </Alert>
+          )}
+          {shown !== null && phase.status === "done" && (
+            <>
+              <div className="grid gap-6 lg:grid-cols-2">
+                <ModelCheckViewer key={phase.key} file={file} mould={shown} loadModel={loadModel} />
+                <section aria-labelledby="model-check-dieline" className="space-y-3">
+                  <h2
+                    id="model-check-dieline"
+                    className="font-display text-ink-primary text-lg font-semibold"
+                  >
+                    Khuôn phẳng tính ra
+                  </h2>
+                  <p className="text-ink-secondary text-sm">
+                    Số trên khuôn phẳng giống số trên model: dùng để tìm cùng một ô ở hai nơi.
+                  </p>
+                  <ul className="text-ink-tertiary list-disc space-y-1 pl-5 text-xs">
+                    <li>{LEGEND.lines}</li>
+                    {file.kind === "cup" && <li>{LEGEND.cup}</li>}
+                    <li>{LEGEND.margins}</li>
+                  </ul>
+                  {shown.template.printAreas.map((area) => {
+                    const surface = shown.surfaces.byCode[area.code];
+                    return surface === undefined ? null : (
+                      <ModelCheckDieline
+                        key={area.code}
+                        area={area}
+                        surface={surface}
+                        seamAtMm={shown.seamAtMm}
+                      />
+                    );
+                  })}
+                </section>
+              </div>
+              <ModelCheckJson file={file} mould={shown} />
+            </>
+          )}
+        </>
+      )}
+    </main>
+  );
+}
