+import type { BagModel, CupModel, PrintAreaCode } from "../template/schema";
+import type { PrintTarget } from "../viewer3d/scene-parts";
+import { NOMINAL_TOLERANCE_MM } from "./issues";
+import type { PrintShape } from "./measure";
+
+/** Same comparison as `compareWithNominal` in `issues.ts`: exactly 1 mm off passes, float noise does not flip it. */
+const TOLERANCE_MM = NOMINAL_TOLERANCE_MM + 1e-9;
+
+const round2 = (n: number) => Math.round(n * 100) / 100;
+
+/** The plane a bag face stands in (`segmentsOf` in `viewer3d/bag-mesh.ts`): FRONT z +g/2, BACK z -g/2, RIGHT x +w/2, LEFT x -w/2. */
+function facePlane(code: PrintAreaCode, model: BagModel): number {
+  switch (code) {
+    case "FRONT":
+      return model.gussetMm / 2;
+    case "BACK":
+      return -model.gussetMm / 2;
+    case "RIGHT":
+      return model.widthMm / 2;
+    default:
+      return -model.widthMm / 2;
+  }
+}
+
+/**
+ * The figures of one mapped mesh that differ from the template by more than 1 mm, at absolute
+ * positions (never through `measurement.model`): a band against the template's printed band
+ * (`surface.vRange` through `y = heightMm · (1 − v / slant)`, as `cup-mesh.ts` has it) and the cone
+ * at those heights; a face against the template's face size, base and plane.
+ */
+export function templateDifferences(
+  { code, surface, shape }: PrintTarget & { shape: PrintShape | null },
+  model: CupModel | BagModel,
+): string[] {
+  const out: string[] = [];
+  const check = (label: string, file: number, template: number) => {
+    if (Math.abs(file - template) > TOLERANCE_MM) {
+      out.push(`${label}: file ${round2(file)} mm, mẫu ${round2(template)} mm`);
+    }
+  };
+  if (!shape) return out;
+
+  if (model.kind === "parametric-cup") {
+    if (shape.kind !== "band") return [`${code}: file là mặt phẳng, mẫu là thân ly`];
+    const slant = Math.hypot(model.heightMm, (model.topDiameterMm - model.bottomDiameterMm) / 2);
+    const [vTop, vBottom] = surface.vRange;
+    const [yTop, yBottom] = [vTop, vBottom].map((v) => model.heightMm * (1 - v / slant)) as [
+      number,
+      number,
+    ];
+    const diameterAt = (y: number) =>
+      model.bottomDiameterMm +
+      ((model.topDiameterMm - model.bottomDiameterMm) * y) / model.heightMm;
+    check("Y đỉnh thân in", shape.topYMm, yTop);
+    check("Y đáy thân in", shape.bottomYMm, yBottom);
+    check("đường kính đỉnh thân in", shape.topDiameterMm, diameterAt(yTop));
+    check("đường kính đáy thân in", shape.bottomDiameterMm, diameterAt(yBottom));
+    return out;
+  }
+
+  if (shape.kind !== "face") return [`${code}: file là thân ly, mẫu là mặt túi`];
+  const sideFace = code === "LEFT" || code === "RIGHT";
+  check(`${code} rộng`, shape.widthMm, sideFace ? model.gussetMm : model.widthMm);
+  check(`${code} cao`, shape.heightMm, model.heightMm - model.topFoldMm);
+  check(`${code} đáy Y`, shape.bottomYMm, 0);
+  check(`${code} vị trí mặt`, shape.offsetMm, facePlane(code, model));
+  // Where the face lies along its own width: `printGeometry` measures `s` from the template's
+  // centre line, so a face shifted sideways would put the artwork off by the same amount.
+  if (Math.abs(shape.centreMm) > TOLERANCE_MM) {
+    out.push(
+      `${code} lệch tâm theo chiều ngang ${round2(Math.abs(shape.centreMm))} mm (tâm file ${round2(shape.centreMm)} mm, mẫu 0 mm)`,
+    );
+  }
+  return out;
+}
diff --git a/src/features/product-design/engine/model3d/dispose.ts b/src/features/product-design/engine/model3d/dispose.ts
new file mode 100644
index 0000000..5e29c6a
--- /dev/null
+++ b/src/features/product-design/engine/model3d/dispose.ts
@@ -0,0 +1,45 @@
+import { type BufferGeometry, type Material, Mesh, type Object3D, Texture } from "three";
+
+/** Every texture a material holds in one of its image slots (`map`, `normalMap`, ...). */
+export function texturesOf(material: Material): Texture[] {
+  return Object.values(material).filter((value): value is Texture => value instanceof Texture);
+}
+
+/** Frees a texture and, for a decoded `ImageBitmap`, its pixels. */
+function disposeTexture(texture: Texture) {
+  const image: unknown = texture.image;
+  texture.dispose();
+  if (image && typeof image === "object" && "close" in image && typeof image.close === "function") {
+    image.close();
+  }
+}
+
+/** Frees materials and the textures they hold, once each. */
+export function disposeMaterials(
+  materials: Iterable<Material>,
+  keep: ReadonlySet<Texture> = new Set(),
+) {
+  const textures = new Set<Texture>();
+  for (const material of new Set(materials)) {
+    for (const texture of texturesOf(material)) if (!keep.has(texture)) textures.add(texture);
+    material.dispose();
+  }
+  textures.forEach(disposeTexture);
+}
+
+export function materialsOf(mesh: Mesh): Material[] {
+  return Array.isArray(mesh.material) ? mesh.material : [mesh.material];
+}
+
+/** Frees the geometry, materials and textures of every mesh below `root`. */
+export function disposeTree(root: Object3D) {
+  const geometries = new Set<BufferGeometry>();
+  const materials = new Set<Material>();
+  root.traverse((object) => {
+    if (!(object instanceof Mesh)) return;
+    geometries.add(object.geometry);
+    materialsOf(object).forEach((material) => materials.add(material));
+  });
+  geometries.forEach((geometry) => geometry.dispose());
+  disposeMaterials(materials);
+}
diff --git a/src/features/product-design/engine/model3d/find-print-meshes.ts b/src/features/product-design/engine/model3d/find-print-meshes.ts
